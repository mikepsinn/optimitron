*.swp
*.swo

# OS
.DS_Store
Thumbs.db
NUL

# Environment / Secrets — NEVER COMMIT THESE
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# API keys, tokens, credentials
secrets/
credentials/
*.secret
*.credential

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Generated reports
reports/*.md
!reports/.gitkeep

# Prisma
packages/db/prisma/dev.db
packages/db/src/generated/

# Terraform / infra state
*.tfstate
*.tfstate.backup
*.timestamp-*
.cache
.cache/

# Migration / backfill JSON dumps (e.g. dih-neobrutalist user export
# consumed by packages/web/scripts/import-dih-users-votes.ts). Never
# commit — contains user PII (emails, phone numbers, IPs).
backups/
**/users-votes-export-*.json
**/.cache/

# Local scratch files
tmp-*
output/
packages/web/output/

# Generated page-copy previews — logged-in views may include user-specific
# content (handle, assigned tasks, plaintiff status). page.logged-out.md is
# committed so PR diffs show copy changes inline.
packages/web/src/app/**/page.logged-in.md
packages/web/src/app/**/page.authed.md
NUL
.vercel
.playwright-mcp/
.optimitron/
.mcp.json
screenshots/
packages/wishonia/.tmp-visuals-body.json
.claude/settings.local.json
packages/web/public/audio/tts-test/
# Large media uploaded to Cloudflare R2 (see scripts/upload-media-to-r2.ts).
# Files live in R2 and are served via NEXT_PUBLIC_MEDIA_CDN_URL.
packages/web/public/media/

.vercel
.claude/scheduled_tasks.lock
