# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo
.next/
.next.stale-*/
next-env.d.ts

# Dev server log (pre-warmed by Claude with stdout/stderr redirection)
.dev-server.log
packages/*/.dev-server.log
.dev-watcher.log
.dev-watcher.pid
packages/*/.dev-watcher.log
packages/*/.dev-watcher.pid

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
NUL

# Environment / Secrets — NEVER COMMIT THESE
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# API keys, tokens, credentials
secrets/
credentials/
*.secret
*.credential

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test coverage
coverage/

# Generated reports
reports/*.md
!reports/.gitkeep

# Prisma
packages/db/prisma/dev.db
packages/db/src/generated/

# Terraform / infra state
*.tfstate
*.tfstate.backup
*.timestamp-*
.cache
.cache/

# Migration / backfill JSON dumps (e.g. dih-neobrutalist user export
# consumed by apps/optimitron/scripts/import-dih-users-votes.ts). Never
# commit — contains user PII (emails, phone numbers, IPs).
backups/
**/users-votes-export-*.json
**/.cache/

# Local scratch files
tmp-*
output/
apps/optimitron/output/

# Generated page-copy previews — logged-in views may include user-specific
# content (handle, assigned tasks, plaintiff status). page.logged-out.md is
# committed so PR diffs show copy changes inline.
apps/optimitron/src/app/**/page.logged-in.md
apps/optimitron/src/app/**/page.authed.md
NUL
.vercel
.playwright-cli/
.playwright-mcp/
.optimitron/
.mcp.json
screenshots/
packages/wishonia/.tmp-visuals-body.json
.claude/settings.local.json
apps/optimitron/public/audio/tts-test/
# Large media uploaded to Cloudflare R2 (see scripts/upload-media-to-r2.ts).
# Files live in R2 and are served via NEXT_PUBLIC_MEDIA_CDN_URL.
apps/optimitron/public/media/

.vercel
.claude/scheduled_tasks.lock
.codex-logs/dashboard-dev.pid
.tmp-*
# Codex CLI session scratch — one-shot prompt files + diagnostic scripts.
# `.codex/config.toml` IS committed; everything else under .codex/ is local.
.codex/prompt-*.txt
.codex/*-test.mjs
.codex/last-commit-message.txt
.codex/last-anonymized-preview.txt
.codex-prompts/
.pr*-*.json
apps/optimitron/scripts/cold-stranger-*.cjs
.codex-tmp/
.claude/state/
.gstack/
apps/optimitron/public/review-variants/
apps/optimitron/screenshots.bak/
