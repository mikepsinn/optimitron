{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/pre-write-architecture-check.mjs",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/safety-gate.mjs hook",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "node .codex/hooks/pre-commit-checklist.mjs",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": ".codex/hooks/check-gstack.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/session-start-pr-check.mjs",
            "timeout": 15000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/surprise-signal.mjs",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
