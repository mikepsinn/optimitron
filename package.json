{
  "name": "optimitron",
  "version": "0.1.0",
  "private": true,
  "description": "The Earth Optimization Game: causal inference, preference aggregation, health tracking, optimal policy & budget generation",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikepsinn/optimitron.git"
  },
  "author": "Mike P. Sinn <m@warondisease.org>",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @optimitron/web dev",
    "build": "pnpm -r build",
    "postinstall": "pnpm --filter @optimitron/db prisma:generate",
    "test": "pnpm -r test",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:generate": "pnpm --filter @optimitron/db run prisma:generate",
    "db:validate": "pnpm --filter @optimitron/db run prisma:validate",
    "db:cli": "pnpm --filter @optimitron/db exec tsx src/db-cli.ts",
    "db:test-data": "pnpm --filter @optimitron/db exec tsx src/cleanup-test-data.ts",
    "db:migrate": "pnpm --filter @optimitron/db run prisma:migrate:dev",
    "db:deploy": "pnpm --filter @optimitron/db run prisma:migrate:deploy",
    "db:test": "pnpm --filter @optimitron/db run test:integration",
    "db:push": "pnpm --filter @optimitron/db run prisma:push",
    "db:sync:managed-data": "node scripts/sync-managed-data.mjs",
    "audit:schema-usage": "pnpm --filter @optimitron/db run audit:schema-usage",
    "db:up": "docker compose up -d --wait postgres",
    "db:setup": "pnpm db:up && pnpm db:deploy && pnpm db:generate && pnpm db:sync:managed-data -- --apply",
    "db:reset": "docker compose down -v && pnpm db:setup",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "alignment:sync": "pnpm --filter @optimitron/web run sync:alignment-politicians",
    "review:test-output": "pnpm --filter @optimitron/agent run review:test-output --",
    "prepare": "husky",
    "dev:warondisease": "pnpm --filter @apps/warondisease dev",
    "dev:dfda": "pnpm --filter @apps/dfda dev",
    "dev:wishocracy": "pnpm --filter @apps/wishocracy dev",
    "dev:trialabundancesurvey": "pnpm --filter @apps/trialabundancesurvey dev",
    "dev:curedao": "pnpm --filter @apps/curedao dev",
    "dev:acceleratedmedicine": "pnpm --filter @apps/acceleratedmedicine dev",
    "typecheck:warondisease": "pnpm --filter @apps/warondisease run typecheck",
    "typecheck:apps": "pnpm --filter \"@apps/*\" run typecheck",
    "lint:apps": "pnpm --filter \"@apps/*\" run lint",
    "build:apps": "pnpm --workspace-concurrency=1 --filter \"@apps/*\" run build",
    "build:app-dependencies": "pnpm --filter @optimitron/optimizer run build && pnpm --filter @optimitron/db run build",
    "smoke:apps": "node scripts/smoke-brand-apps.mjs",
    "test:apps:unit": "pnpm --filter \"@apps/*\" run test:unit",
    "test:warondisease:unit": "pnpm --filter @apps/warondisease run test:unit",
    "smoke:warondisease-db": "pnpm --filter @apps/warondisease exec tsx scripts/smoke-treaty-db.ts"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "packages/!(site-kit)/src/**/*.ts": [
      "pnpm exec eslint --fix --no-warn-ignored"
    ],
    "packages/db/prisma/**/*.prisma": [
      "pnpm --filter @optimitron/db exec prisma validate",
      "pnpm --filter @optimitron/db exec prisma format"
    ]
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "hono@>=4.0.0 <4.12.12": ">=4.12.12",
      "import-in-the-middle": "3.0.0",
      "@types/node": "^20.19.37",
      "next": "15.5.15",
      "next-auth": "4.24.15"
    }
  }
}
