{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "routes": [
    {
      "src": "^/(?:people/(?!manage(?:/|$))[^/]+|tasks/[^/]+)(?:/opengraph-image)?/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(curl|wget|python|scrapy|go-http-client|httpclient|java/|okhttp|libwww-perl|perl|php|ruby|axios|node-fetch|undici)"
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    },
    {
      "src": "^/(?:people/(?!manage(?:/|$))[^/]+|tasks/[^/]+)(?:/opengraph-image)?/?$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "^\\s*$"
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    },
    {
      "src": "^/(?:people/(?!manage(?:/|$))[^/]+|tasks/[^/]+)(?:/opengraph-image)?/?$",
      "missing": [
        {
          "type": "header",
          "key": "user-agent"
        }
      ],
      "mitigate": {
        "action": "challenge"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/run-due-triggers",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/task-overdue-reminders",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/alignment-politicians",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/push-notifications",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/vote-token-mint",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/aggregate-relationships",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/referral-hypercert-publish",
      "schedule": "0 */12 * * *"
    },
    {
      "path": "/api/cron/daily-activity-digest",
      "schedule": "5 13 * * *"
    }
  ]
}
