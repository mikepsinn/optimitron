{
  "name": "@optimitron/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "ensure-env": "node scripts/ensure-env.js",
    "guard:local-dev-db": "node scripts/guard-local-dev-db.mjs",
    "validate:content": "node scripts/validate-content.js",
    "build:db-client": "pnpm --dir ../.. --filter @optimitron/db prisma:generate",
    "build:workspace-deps": "pnpm --dir ../.. -r --filter @optimitron/db --filter @optimitron/optimizer --filter @optimitron/wishocracy --filter @optimitron/opg --filter @optimitron/obg --filter @optimitron/data --filter @optimitron/agent --filter @optimitron/chat-ui --filter @optimitron/storage --filter @optimitron/hypercerts --filter @optimitron/wishonia-widget build",
    "kill-port": "node -e \"try{require('child_process').execSync('npx kill-port 3001',{stdio:'ignore'})}catch{}\"",
    "dev": "pnpm run kill-port && pnpm run ensure-env && pnpm run guard:local-dev-db && pnpm run build:workspace-deps && cross-env NODE_OPTIONS=--max-old-space-size=6144 pnpm exec next dev --port 3001 --turbopack",
    "dev:fast": "pnpm run ensure-env && pnpm run guard:local-dev-db && cross-env NODE_OPTIONS=--max-old-space-size=6144 pnpm exec next dev --port 3001 --turbopack",
    "dev:watch": "node scripts/dev-watcher.mjs",
    "build": "pnpm run ensure-env && pnpm run validate:content && pnpm run build:workspace-deps && node scripts/next-build.mjs",
    "build:vercel": "node scripts/run-with-timeout.mjs 420 pnpm run build",
    "build:fast": "pnpm run ensure-env && pnpm run validate:content && next build",
    "start": "pnpm run ensure-env && next start",
    "sync:alignment-politicians": "tsx scripts/sync-alignment-politicians.ts",
    "generate:government-size": "pnpm --dir ../examples run generate:government-size",
    "sync:government-size": "tsx scripts/sync-government-size-analysis.ts",
    "refresh:government-size": "pnpm run generate:government-size && pnpm run sync:government-size",
    "lint": "next lint",
    "typecheck": "pnpm run build:workspace-deps && pnpm run typecheck:fast",
    "typecheck:fast": "pnpm run typecheck:app && pnpm run typecheck:tests",
    "typecheck:app": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit --project tsconfig.next.json",
    "typecheck:tests": "cross-env NODE_OPTIONS=--max-old-space-size=6144 tsc --noEmit --project tsconfig.tests.json",
    "typecheck:full": "cross-env NODE_OPTIONS=--max-old-space-size=8192 tsc --noEmit",
    "test": "node --test scripts/visual-review-coverage.test.mjs && pnpm exec vitest run",
    "generate": "tsx scripts/generate-web-data.ts",
    "fetch": "tsx scripts/fetch-and-generate.ts",
    "causal": "tsx scripts/generate-causal-reports.ts",
    "generate:assets": "tsx scripts/generate-brand-assets.ts",
    "e2e": "node scripts/run-playwright.mjs",
    "e2e:visual": "node scripts/run-playwright.mjs visual",
    "visual:review": "node scripts/build-visual-review.mjs",
    "review:local": "node scripts/review-local.mjs",
    "messages:review": "node scripts/build-message-review.mjs",
    "e2e:demo": "playwright test e2e/demo-recording.spec.ts",
    "demo:narration": "tsx scripts/generate-narration.ts",
    "demo:record": "tsx scripts/record-demo.ts",
    "audit:colors": "tsx scripts/audit-colors.ts",
    "fix:colors": "tsx scripts/fix-colors.ts",
    "extract:copy": "tsx scripts/extract-copy.ts",
    "copy:preview": "node scripts/copy-preview-smart.mjs",
    "copy:gate": "tsx scripts/copy-review-gate.ts",
    "copy:preview:all": "tsx scripts/render-pages-to-markdown.ts",
    "email:preview-md": "tsx scripts/render-emails-to-markdown.ts",
    "extract:tasks": "tsx scripts/extract-tasks-from-manual.ts",
    "import:treaty-model": "tsx scripts/import-treaty-policy-model.ts",
    "import:notion": "node scripts/guard-local-dev-db.mjs && tsx scripts/import-notion-bundle.ts",
    "bootstrap:parameters": "tsx scripts/bootstrap-parameters.ts",
    "sync:treaty-signers": "tsx scripts/sync-treaty-signers.ts",
    "sync:task-triggers": "tsx scripts/sync-task-triggers.ts",
    "mcp:tasks": "tsx scripts/mcp-task-server.ts",
    "mcp:claude-task": "tsx scripts/claude-code-optimitron-task.ts",
    "report:task-tree": "tsx scripts/export-task-tree.ts",
    "report:next-action": "tsx scripts/report-next-action.ts",
    "draft:legislation": "tsx scripts/draft-legislation.ts",
    "media:upload": "tsx scripts/upload-media-to-r2.ts",
    "check:r2-upload": "tsx scripts/check-r2-upload.ts"
  },
