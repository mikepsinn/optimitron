    "@t3-oss/env-nextjs": "^0.13.11",
    "bcryptjs": "latest",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.454.0",
    "nanoid": "latest",
    "next-themes": "latest",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react-icons": "^5.5.0",
