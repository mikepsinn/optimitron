{
  "name": "@optimitron/db",
  "version": "0.1.0",
  "description": "Prisma schema and database client for Wishocracy",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/generated/prisma/enums.d.ts",
      "default": "./dist/generated/prisma/enums.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./task-keys": {
      "types": "./dist/task-keys.d.ts",
      "default": "./dist/task-keys.js"
    },
    "./system-identities": {
      "types": "./dist/system-identities.d.ts",
      "default": "./dist/system-identities.js"
    },
    "./managed-data": {
      "types": "./dist/managed-data/index.d.ts",
      "default": "./dist/managed-data/index.js"
    },
    "./managed-task-triggers": {
      "types": "./dist/managed-data/managed-task-triggers.d.ts",
      "default": "./dist/managed-data/managed-task-triggers.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "tsx src/run-local-db-tests.ts",
    "test:watch": "vitest",
    "db:cli": "tsx src/db-cli.ts",
    "db:test-data": "tsx src/cleanup-test-data.ts",
    "audit:schema-usage": "tsx src/schema-usage-audit.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:push": "prisma db push --schema prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts",
    "sync:managed-data": "tsx scripts/sync-managed-data.ts"
  },
  "dependencies": {
    "@optimitron/data": "workspace:*",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "dotenv": "^16.6.1",
    "prisma": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
