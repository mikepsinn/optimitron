  reportedByUser             User?                              @relation("UserReportedInterventionExperiences", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  conditionGlobalVariable    GlobalVariable?                    @relation("InterventionExperienceConditionVariable", fields: [conditionGlobalVariableId], references: [id], onDelete: SetNull)
