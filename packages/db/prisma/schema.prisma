// LAYER 2 — Domain-Specific Governance
// ============================================================================

/// A jurisdiction (city, county, state, country) — the tenant for governance data
model Jurisdiction {
  /// Unique identifier for this jurisdiction
  id String @id @default(cuid())

  /// Human-readable name (e.g. "California", "United States")
  name String

  /// Level of government
  type JurisdictionType

  /// Parent jurisdiction ID for hierarchy (e.g. city → county → state → country)
  parentJurisdictionId String?

  /// Relation to the parent Jurisdiction
  parent Jurisdiction? @relation("JurisdictionHierarchy", fields: [parentJurisdictionId], references: [id])

  /// Child jurisdictions in the hierarchy
  children Jurisdiction[] @relation("JurisdictionHierarchy")

  /// ISO codes, FIPS codes, etc. (e.g. "US", "US-CA", "US-CA-037")
  code String? @unique

  /// Currency code used in this jurisdiction (e.g. "USD", "EUR")
  currency String @default("USD")

  /// Estimated population of this jurisdiction
  population Int?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  subjects                      Subject[]                        @relation("JurisdictionSubject")
  items                         WishocraticItem[]
  politicians                   Politician[]
  aggregationRuns               AggregationRun[]
  referendums                   Referendum[]
  organizations                 Organization[]
  surveys                       Survey[]
  tasks                         Task[]
  taskTriggers                  TaskTrigger[]                    @relation("JurisdictionTaskTriggers")
  conflicts                     Conflict[]                       @relation("ConflictPrimaryJurisdiction")
  memorialResponsibleParties    PersonMemorialResponsibleParty[] @relation("JurisdictionPersonMemorialResponsibleParties")
  interventionApprovalTimelines InterventionApprovalTimeline[]   @relation("JurisdictionInterventionApprovalTimelines")

  @@index([type])
  @@index([parentJurisdictionId])
}

/// A priority/wish/budget item that can be compared in pairwise evaluations
model WishocraticItem {
  /// Unique identifier for this item
  id String @id @default(cuid())

  /// Jurisdiction this item belongs to
  jurisdictionId String

  /// Relation to the Jurisdiction
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  /// Human-readable name of the item (e.g. "National Defense", "Medicare")
  name String

  /// Longer explanation of what this item covers
  description String?

  /// Current actual budget allocation in USD (for preference gap analysis)
  currentAllocationUsd Float?

  /// Current actual budget allocation as a percentage of total (for preference gap analysis)
  currentAllocationPct Float?

  /// URL to supporting documentation or source data
  sourceUrl String?

  /// Whether this item is active for comparisons
  active Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  weights                        PreferenceWeight[]
  wishAllocationsAsA             WishocraticAllocation[]         @relation("wishItemA")
  wishAllocationsAsB             WishocraticAllocation[]         @relation("wishItemB")
  itemInclusions                 WishocraticItemInclusion[]
  politicianVotes                PoliticianVote[]
  wishocraticItemAlignmentScores WishocraticItemAlignmentScore[]
  publicGoodsRecipients          PublicGoodsRecipient[]          @relation("publicGoodsItem")

  @@unique([jurisdictionId, name])
  @@index([jurisdictionId])
  @@index([active])
  @@map("Item")
}

/// Referral/signup record for tracking who brought in a user
model Referral {
  /// Unique identifier for this referral
  id String @id @default(cuid())

  /// Whether the user opted into the referral/signup flow
  answer ReferralAnswer

  /// The user who signed up (one referral per user)
  userId String? @unique

  /// The user whose referral link led to this signup
  referredByUserId String?

  /// ShareAttempt that originated the shared link this user clicked to sign up.
  /// Loose reference (no FK) — tolerates orphan sa= values from failed background POSTs.
  originatingShareAttemptId String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  referrer User? @relation("UserReferrals", fields: [referredByUserId], references: [id])
  user     User? @relation("UserReferral", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([referredByUserId])
  @@index([originatingShareAttemptId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Logs every hit on a /r/[code] referral link so we can trace
/// where shares originated (HTTP referer) and detect viral spikes.
model ReferralClick {
  /// Unique identifier
  id String @id @default(cuid())

  /// The referral code from the URL (username or referralCode)
  code String

  /// The user who owns this referral code (resolved at click time, nullable if code is invalid)
  referrerUserId String?

  /// ShareAttempt that generated the URL this recipient clicked (from ?sa= query param).
  /// Loose reference (no FK) — tolerates orphan sa= values.
  shareAttemptId String?

  /// HTTP Referer header — e.g. "https://x.com/PMCanada/status/123..."
  refererUrl String?

  /// User-Agent header (helps distinguish bots from real clicks)
  userAgent String?

  /// IP-derived country code for geographic analysis (no full IP stored)
  countryCode String?

  /// When this click occurred
  createdAt DateTime @default(now())

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  referrer User? @relation("UserReferralClicks", fields: [referrerUserId], references: [id])

  @@index([code])
  @@index([referrerUserId])
  @@index([shareAttemptId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Directed invitation from a verified voter to a specific named recipient.
/// Complements generic Referral/ShareAttempt analytics by tracking invite-token
/// lifecycle, reminder state, and conversion to a referendum vote.
model ReferralInvitation {
  /// Unique identifier
  id String @id @default(cuid())

  /// Sender / referrer who created the invitation
  referrerUserId String

  /// Optional recipient Person record, created later when useful
  recipientPersonId String?

  /// Optional referendum this invitation asks the recipient to vote on
  referendumId String?

  /// Optional task created or linked for this recipient
  taskId String?

  /// Optional ShareAttempt that produced the copied/sent message
  shareAttemptId String?

  /// Vote that converted this invitation
  convertedVoteId String? @unique

  /// Opaque token carried in invite links
  inviteToken String @unique

  /// Sender-provided display name for the recipient
  recipientName String

  /// Recipient email if the sender provided one
  recipientEmail String?

  /// Primary channel for this invitation
  contactMethod ReferralInvitationContactMethod?

  /// Message family selected by the sender
  messageFormat ReferralInvitationMessageFormat @default(SINCERE)

  /// Rendered or edited message text the sender saw/sent
  messageText String?

  /// Current lifecycle status
  status ReferralInvitationStatus @default(PENDING)

  /// When the sender copied the message/link
  copiedAt DateTime?

  /// When a server-side invite email was sent
  sentAt DateTime?

  /// When the invitation first converted to a verified vote
  convertedAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  /// Full URL the inviter was on when they composed this invitation
  /// (with query string for UTM / referral / campaign forensics).
  /// Captured at insert time from the client's `window.location.href`.
  /// Variant key is derivable from the URL's host on demand. Mirrors
  /// `User.signupLandingUrl` and `ReferendumVote.originUrl` — one
  /// column shape, one mental model.
  originUrl String?

  // -- Relations --
  referrer           User                @relation("ReferralInvitationReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  recipient          Person?             @relation("ReferralInvitationRecipientPerson", fields: [recipientPersonId], references: [id], onDelete: SetNull)
  referendum         Referendum?         @relation(fields: [referendumId], references: [id], onDelete: SetNull)
  task               Task?               @relation("TaskReferralInvitations", fields: [taskId], references: [id], onDelete: SetNull)
  shareAttempt       ShareAttempt?       @relation("ShareAttemptReferralInvitations", fields: [shareAttemptId], references: [id], onDelete: SetNull)
  convertedVote      ReferendumVote?     @relation("ReferralInvitationConvertedVote", fields: [convertedVoteId], references: [id], onDelete: SetNull)
  taskCommunications TaskCommunication[] @relation("ReferralInvitationTaskCommunications")

  @@index([referrerUserId, createdAt])
  @@index([recipientPersonId])
  @@index([referendumId])
  @@index([taskId])
  @@index([shareAttemptId])
  @@index([status])
  @@index([deletedAt])
}

/// Saved pairwise allocations for authenticated Wishocracy users
model WishocraticAllocation {
  /// Unique identifier for this allocation
  id String @id @default(cuid())

  /// The user who made this pairwise allocation
  userId String

  /// First item in the normalized pair (FK to WishocraticItem — budget category)
  itemAId String

  /// Second item in the normalized pair (FK to WishocraticItem — budget category)
  itemBId String

  /// Allocation to item A (0-100, represents share of hypothetical $100)
  allocationA Int

  /// Allocation to item B (0-100, represents share of hypothetical $100)
  allocationB Int

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  user  User            @relation("UserWishocraticAllocations", fields: [userId], references: [id], onDelete: Cascade)
  itemA WishocraticItem @relation("wishItemA", fields: [itemAId], references: [id])
  itemB WishocraticItem @relation("wishItemB", fields: [itemBId], references: [id])

  @@unique([userId, itemAId, itemBId])
  @@index([userId])
  @@index([itemAId])
  @@index([itemBId])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Persisted yes/no item-inclusion decisions for the Wishocracy pre-allocation screen.
/// A row with included=true means the user chose to include this item; included=false
/// means they explicitly excluded it; no row means they haven't decided yet.
model WishocraticItemInclusion {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who made this choice
  userId String

  /// Wishocratic item being included or excluded
  itemId String

  /// Whether the item is included in the user's allocation run
  included Boolean

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  user User            @relation("UserWishocraticItemInclusions", fields: [userId], references: [id], onDelete: Cascade)
  item WishocraticItem @relation(fields: [itemId], references: [id])

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
  @@index([included])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Aggregated preference weights (output of eigenvector calculation)
model PreferenceWeight {
  /// Unique identifier for this preference weight
  id String @id @default(cuid())

  /// Which calculation run produced this weight
  aggregationRunId String

  /// Relation to the AggregationRun
  aggregationRun AggregationRun @relation(fields: [aggregationRunId], references: [id])

  /// The item this weight applies to
  itemId String

  /// Relation to the WishocraticItem
  item WishocraticItem @relation(fields: [itemId], references: [id])

  /// Normalized weight (0-1, all weights in a run sum to 1)
  weight Float

  /// Rank of this item within the run (1 = highest priority)
  rank Int

  /// Lower bound of the confidence interval for this weight
  ciLow Float?

  /// Upper bound of the confidence interval for this weight
  ciHigh Float?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  @@unique([aggregationRunId, itemId])
  @@index([aggregationRunId])
}

/// Record of each aggregation calculation (eigenvector computation run)
model AggregationRun {
  /// Unique identifier for this aggregation run
  id String @id @default(cuid())

  /// Jurisdiction this run was computed for
  jurisdictionId String

  /// Relation to the Jurisdiction
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  /// Total pairwise allocations included in this run
  allocationCount Int

  /// Total unique participants included in this run
  participantCount Int

  /// AHP consistency ratio (< 0.1 = good)
  consistencyRatio Float?

  /// Filter: which Wishocratic items were included (null = all)
  itemFilter String?

  /// Filter: which region was included (null = all)
  regionFilter String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  weights         PreferenceWeight[]
  alignmentScores AlignmentScore[]

  @@index([jurisdictionId])
}

/// Politician/legislator/official voting records for alignment scoring
model Politician {
  /// Unique identifier for this politician
  id String @id @default(cuid())

  /// Jurisdiction this politician represents
  jurisdictionId String

  /// Relation to the Jurisdiction
  jurisdiction Jurisdiction @relation(fields: [jurisdictionId], references: [id])

  /// Full name of the politician
  name String

  /// Political party affiliation
  party String?

  /// Title: "Senator", "Mayor", "Council Member", etc.
  title String?

  /// State, ward, district — varies by jurisdiction
  district String?

  /// Legislative chamber: "house" | "senate" | "council" | null
  chamber String?

  /// External identifier: bioguide ID, local govt ID, etc.
  externalId String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  votes      PoliticianVote[]
  alignments AlignmentScore[]

  @@unique([jurisdictionId, externalId])
  @@index([jurisdictionId])
  @@index([party])
}

/// A politician's vote or position on a budget item
model PoliticianVote {
  /// Unique identifier for this vote record
  id String @id @default(cuid())

  /// The politician who cast this vote
  politicianId String

  /// Relation to the Politician
  politician Politician @relation(fields: [politicianId], references: [id])

  /// Budget item this vote applies to (FK to WishocraticItem)
  itemId String

  /// Relation to the WishocraticItem
  item WishocraticItem @relation(fields: [itemId], references: [id])

  /// Their allocated/voted percentage
  allocationPct Float

  /// Source bill or vote reference identifier
  billId String?

  /// When this vote was cast
  votedAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  @@unique([politicianId, itemId])
  @@index([politicianId])
  @@index([itemId])
}

/// Calculated alignment between citizen preferences and politician votes
model AlignmentScore {
  /// Unique identifier for this alignment score
  id String @id @default(cuid())

  /// The politician being scored
  politicianId String

  /// Relation to the Politician
  politician Politician @relation(fields: [politicianId], references: [id])

  /// Which aggregation run's weights were used to compute this score
  aggregationRunId String

  /// Relation to the AggregationRun
  aggregationRun AggregationRun @relation(fields: [aggregationRunId], references: [id])

  /// Overall alignment score (0-100%)
  score Float

  /// Number of votes compared in this calculation
  votesCompared Int

  /// When this score was published to the public API / Hypercerts
  publishedAt DateTime?

  /// On-chain reference (Hypercert CID or Merkle leaf hash)
  onChainRef String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  itemScores WishocraticItemAlignmentScore[]

  @@unique([politicianId, aggregationRunId])
  @@index([politicianId])
  @@index([aggregationRunId])
  @@index([score])
}

/// Per-item alignment breakdown for a politician in an aggregation run
model WishocraticItemAlignmentScore {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent alignment score
  alignmentScoreId String

  /// Relation to the AlignmentScore
  alignmentScore AlignmentScore @relation(fields: [alignmentScoreId], references: [id], onDelete: Cascade)

  /// Wishocratic item (FK to WishocraticItem)
  itemId String

  /// Relation to the WishocraticItem
  item WishocraticItem @relation(fields: [itemId], references: [id])

  /// Alignment score for this item (0-100%)
  score Float

  @@unique([alignmentScoreId, itemId])
  @@index([alignmentScoreId])
  @@index([itemId])
}

// ============================================================================
// CIVIC ENGAGEMENT
// ============================================================================

/// Position a citizen takes on a bill
enum VotePosition {
  YES
  NO
  ABSTAIN
}

/// How a referendum position was entered.
enum ReferendumVoteSource {
  SELF
  REPRESENTED
}

/// A citizen's vote on a specific legislative bill, with optional CBA snapshot
model CitizenBillVote {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who cast this vote
  userId String

  /// Bill identifier e.g. "119-hr-1234"
  billId String

  /// Human-readable bill title at time of vote
  billTitle String

  /// The citizen's position
  position VotePosition

  /// Optional reasoning / notes
  reasoning String?

  /// Jurisdiction scope (optional)
  jurisdictionId String?

  /// Unique shareable identifier for public vote page
  shareIdentifier String @unique @default(cuid())

  /// JSON snapshot of cost-benefit analysis at time of vote
  cbaSnapshot String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Relation to the user
  user User @relation("UserCitizenBillVotes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billId])
  @@index([userId])
  @@index([billId])
  @@index([jurisdictionId])
  @@index([shareIdentifier])
}

/// Web push notification subscription for PWA push
model WebPushSubscription {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who subscribed
  userId String

  /// Push endpoint URL (unique per browser)
  endpoint String @unique

  /// P-256 Diffie-Hellman public key (base64)
  p256dh String

  /// Authentication secret (base64)
  auth String

  /// Browser user agent for debugging
  userAgent String?

  /// When subscription was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Last time a notification was sent to this subscription
  lastSentAt DateTime?

  /// Whether subscription has expired (410 Gone response)
  expired Boolean @default(false)

  // -- Relations --
  user User @relation("UserWebPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expired])
}

/// User preferences for push notification timing and quiet hours
/// (Renamed from NotificationPreference — maps to same table for migration continuity)
model UserPreference {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user this preference belongs to
  userId String @unique

  /// Whether push notifications are enabled
  pushEnabled Boolean @default(true)

  /// How often to send reminders (minutes)
  reminderFrequencyMinutes Int @default(1440)

  /// Earliest time to send (HH:MM format)
  reminderStartTime String @default("09:00")

  /// Latest time to send (HH:MM format)
  quietHoursStart String @default("21:00")

  /// When the last push was sent
  lastPushSentAt DateTime?

  /// When the user last completed a check-in
  lastCheckInAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  user User @relation("UserPreference", fields: [userId], references: [id], onDelete: Cascade)

  @@map("UserPreference")
}

/// Encrypted pairwise allocations for Wishocracy (replaces plaintext per-comparison rows)
model WishocraticEncryptedAllocation {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who made these allocations
  userId String @unique

  /// AES-GCM encrypted JSON blob containing all pairwise allocations
  ciphertext String

  /// Initialization vector for AES-GCM (base64)
  iv String

  /// Encryption algorithm identifier
  algorithm String @default("AES-GCM-256")

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  user User @relation("UserEncryptedAllocations", fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================================
// LAYER 3 — Referendums & Verified Votes
// ============================================================================

enum ReferendumStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// A public referendum that users can vote on (e.g., "Should we adopt the 1% Treaty?")
model Referendum {
  /// Unique identifier
  id String @id @default(cuid())

  /// Human-readable title
  title String

  /// URL-safe slug for routing
  slug String @unique

  /// Rich description or framing text
  description String?

  /// User who created this referendum (optional for system-created ones)
  createdByUserId String?

  /// Optional jurisdiction scope
  jurisdictionId String?

  /// Whether this referendum is accepting votes
  status ReferendumStatus @default(ACTIVE)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  createdBy             User?                            @relation("UserCreatedReferendums", fields: [createdByUserId], references: [id])
  jurisdiction          Jurisdiction?                    @relation(fields: [jurisdictionId], references: [id])
  votes                 ReferendumVote[]
  voteTokenMints        VoteTokenMint[]
  surveys               Survey[]
  organizationPositions OrganizationReferendumPosition[]
  referralInvitations   ReferralInvitation[]

  @@index([slug])
  @@index([status])
  @@index([jurisdictionId])
  @@index([createdByUserId])
}

/// A referendum position for a Person, entered by a signed-in User
model ReferendumVote {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who entered this vote
  userId String

  /// The human whose position this row records
  personId String

  /// Which referendum this vote is for
  referendumId String

  /// The citizen's position
  answer VotePosition

  /// Whether this was entered by the person themself or by someone representing them
  voteSource ReferendumVoteSource @default(SELF)

  /// Who brought this voter in via referral link
  referredByUserId String?

  /// Organization context for partner-hosted survey or embed attribution
  organizationId String?

  /// Optional public note attached to represented or self-entered positions
  publicComment String?

  /// Whether this vote can appear on public vote/person surfaces
  isPublic Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  /// Full URL the voter was on when they cast this vote (with query
  /// string for UTM / referral / campaign forensics). Captured at insert
  /// time from the client's `window.location.href`. Variant key is
  /// derivable from the URL's host on demand. Mirrors `User.signupLandingUrl`
  /// and `ReferralInvitation.originUrl`.
  originUrl String?

  // -- Relations --
  user                        User                @relation("UserReferendumVotes", fields: [userId], references: [id], onDelete: Cascade)
  person                      Person              @relation("PersonReferendumVotes", fields: [personId], references: [id], onDelete: Cascade)
  referendum                  Referendum          @relation(fields: [referendumId], references: [id])
  referrer                    User?               @relation("UserReferendumReferrals", fields: [referredByUserId], references: [id])
  organization                Organization?       @relation("OrganizationReferendumVotes", fields: [organizationId], references: [id])
  convertedReferralInvitation ReferralInvitation? @relation("ReferralInvitationConvertedVote")

  @@unique([referendumId, personId])
  @@index([userId])
  @@index([userId, referendumId])
  @@index([personId])
  @@index([referendumId])
  @@index([referendumId, answer, voteSource, deletedAt])
  @@index([referredByUserId])
  @@index([organizationId])
  @@index([createdAt])
}

// ============================================================================
// VOTE TOKEN & VOTER PRIZE TREASURY
// ============================================================================

enum VoteTokenMintStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

/// Type of user-facing receipt published through Hypercert / AT Protocol flows
/// Links a referendum vote to an on-chain VOTE token mint.
/// 1 VOTE to the referrer per referred verified vote per referendum.
model VoteTokenMint {
  /// Unique identifier
  id String @id @default(cuid())

  /// The referrer who receives the VOTE reward
  userId String

  /// Which referendum this mint is for
  referendumId String

  /// World ID nullifier hash (sybil resistance)
  nullifierHash String

  /// Wallet address receiving the VOTE tokens
  walletAddress String

  /// Amount of VOTE tokens (BigInt as string, e.g. "1000000000000000000" = 1 VOTE)
  amount String

  /// On-chain transaction hash (set after submission)
  txHash String?

  /// Chain ID where the transaction was submitted
  chainId Int

  /// Mint lifecycle status
  status VoteTokenMintStatus @default(PENDING)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  user       User       @relation("UserVoteTokenMints", fields: [userId], references: [id], onDelete: Cascade)
  referendum Referendum @relation(fields: [referendumId], references: [id])

  @@unique([nullifierHash, referendumId])
  @@index([userId])
  @@index([userId, referendumId])
  @@index([referendumId])
  @@index([status])
}

/// Records a contributor's stablecoin deposit into the VoterPrizeTreasury.
model PrizeTreasuryDeposit {
  /// Unique identifier
  id String @id @default(cuid())

  /// On-chain wallet that made the deposit
  depositorAddress String

  /// Deposit amount (BigInt as string)
  amount String

  /// PRIZE shares received (BigInt as string)
  sharesReceived String

  /// On-chain transaction hash
  txHash String

  /// Chain ID where the deposit was made
  chainId Int

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  @@index([depositorAddress])
  @@index([txHash])
  @@index([createdAt])
}

// ============================================================================
// WISHOCRATIC TREASURY
// ============================================================================

/// A registered public goods recipient for a budget category.
/// Maps budget categories to on-chain wallet addresses that receive $WISH.
model PublicGoodsRecipient {
  /// Unique identifier
  id String @id @default(cuid())

  /// Budget category item (FK to WishocraticItem — e.g., "UNIVERSAL_BASIC_INCOME")
  itemId String @unique

  /// Relation to the WishocraticItem
  item WishocraticItem @relation("publicGoodsItem", fields: [itemId], references: [id])

  /// Human-readable name
  name String

  /// On-chain wallet address (receives $WISH from WishocraticTreasury)
  walletAddress String

  /// Whether this recipient is currently active
  active Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?
}

/// A record of a Wishocratic distribution event on-chain.
model WishocraticDistribution {
  /// Unique identifier
  id String @id @default(cuid())

  /// Total $WISH distributed (bigint as string for precision)
  totalAmount String

  /// Number of recipients in this distribution
  recipientCount Int

  /// Hash of the allocation weights used (for auditability)
  weightsHash String

  /// On-chain transaction hash
  txHash String?

  /// When this distribution occurred
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  @@index([weightsHash])
}

// ============================================================================
// ACTIVITY LOG & NOTIFICATIONS
// ============================================================================

/// Unified audit/activity event stream for transparency and engagement history
model Activity {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who performed this action
  userId String

  /// Type of activity
  type ActivityType

  /// Human-readable description of the event
  description String?

  /// JSON-encoded metadata payload (context-specific)
  metadata String?

  /// Polymorphic entity type (e.g. "Referendum", "Item", "PrizeTreasuryDeposit")
  entityType String?

  /// ID of the related entity
  entityId String?

  /// When this event occurred
  createdAt DateTime @default(now())

  // -- Relations --
  user       User        @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  wishPoints WishPoint[] @relation("WishPointActivity")

  @@index([userId, createdAt])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

/// General in-app notification for a user
model Notification {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user this notification is for
  userId String

  /// Notification category
  type NotificationType

  /// Short notification title
  title String

  /// Notification body text
  message String

  /// Optional deep link URL
  link String?

  /// Whether the user has read this notification
  isRead Boolean @default(false)

  /// When the notification was read
  readAt DateTime?

  /// When this notification was created
  createdAt DateTime @default(now())

  // -- Relations --
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt])
}

/// Per-type, per-channel notification preference (replaces global push toggle)
model NotificationPreference {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user this preference belongs to
  userId String

  /// Which notification type this preference controls
  type NotificationType

  /// Which delivery channel
  channel NotificationChannel

  /// Whether this type+channel combination is enabled
  enabled Boolean @default(true)

  // -- Relations --
  user User @relation("UserNotificationPreferences", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
}

// ============================================================================
// ORGANIZATIONS
// ============================================================================

/// An organization that participates in governance (university, DAO, advocacy group, etc.)
model Organization {
  /// Unique identifier
  id String @id @default(cuid())

  /// Organization name
  name String

  /// URL-safe slug for routing
  slug String @unique

  /// Description of the organization's mission
  description String?

  /// Classification of the organization
  type OrgType

  /// Approval status
  status OrgStatus @default(PENDING)

  /// Optional jurisdiction scope
  jurisdictionId String?

  /// User who created/registered this organization
  creatorId String?

  /// Organization website URL
  website String?

  /// Logo image URL
  logo String?

  /// Source URL used when this organization was imported from external data
  sourceUrl String?

  /// Stable source reference used for idempotent imports
  sourceRef String? @unique

  /// Contact email address
  contactEmail String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  jurisdiction               Jurisdiction?                    @relation(fields: [jurisdictionId], references: [id])
  creator                    User?                            @relation("OrgCreator", fields: [creatorId], references: [id])
  members                    OrganizationMember[]
  assignedTasks              Task[]                           @relation("TaskAssigneeOrganization")
  authoredTaskComments       TaskComment[]                    @relation("TaskCommentAuthorOrganization")
  receivedTaskCommunications TaskCommunication[]              @relation("TaskCommunicationRecipientOrganization")
  subjects                   Subject[]                        @relation("OrganizationSubject")
  referendumPositions        OrganizationReferendumPosition[]
  referendumVotes            ReferendumVote[]                 @relation("OrganizationReferendumVotes")
  surveyResponses            SurveyResponse[]                 @relation("OrganizationSurveyResponses")
  memorialResponsibleParties PersonMemorialResponsibleParty[] @relation("OrganizationPersonMemorialResponsibleParties")

  @@index([slug])
  @@index([type])
  @@index([status])
  @@index([jurisdictionId])
  @@index([creatorId])
  @@index([deletedAt])
}

/// Membership link between a user and an organization
model OrganizationMember {
  /// Unique identifier
  id String @id @default(cuid())

  /// The organization
  organizationId String

  /// The member user
  userId String

  /// Role within the organization (e.g. "admin", "member", "viewer")
  role String @default("member")

  /// When the user joined
  joinedAt DateTime @default(now())

  // -- Relations --
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("UserOrgMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

/// Official organizational position on a referendum. Distinct from
/// ReferendumVote (which is per-user) and from Organization.status
/// (which is org-level existence/approval).
model OrganizationReferendumPosition {
  /// Unique identifier
  id String @id @default(cuid())

  /// The organization taking the position
  organizationId String

  /// The referendum the position is on
  referendumId String

  /// YES / NO / ABSTAIN
  position VotePosition

  /// Optional public statement from the organization
  statement String?

  /// User who submitted this position on behalf of the organization
  submittedByUserId String?

  /// Admin who approved or rejected this position
  approvedByUserId String?

  /// Per-referendum approval status (independent of Organization.status)
  status OrganizationReferendumPositionStatus @default(PENDING)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  referendum   Referendum   @relation(fields: [referendumId], references: [id], onDelete: Cascade)
  submittedBy  User?        @relation("OrgPositionSubmitter", fields: [submittedByUserId], references: [id])
  approvedBy   User?        @relation("OrgPositionApprover", fields: [approvedByUserId], references: [id])

  @@unique([organizationId, referendumId])
  @@index([organizationId])
  @@index([referendumId])
  @@index([status])
  @@index([submittedByUserId])
  @@index([approvedByUserId])
  @@index([deletedAt])
}

// ============================================================================
// TASKS
// ============================================================================

/// A public task that can be assigned to a person or claimed by players
model Task {
  /// Unique identifier
  id String @id @default(cuid())

  /// Optional jurisdiction this task advances
  jurisdictionId String?

  /// Optional parent task for task-tree decomposition
  parentTaskId String?

  /// Optional person this task is addressed to
  assigneePersonId String?

  /// Optional organization this task is addressed to
  assigneeOrganizationId String?

  /// User who verified this task's completion
  verifiedByUserId String?

  /// Optional user who owns this task in personal/project task views
  ownerUserId String?

  /// Current published impact estimate set used by APIs and ranking
  currentImpactEstimateSetId String? @unique

  /// Stable task identity for idempotent extraction and imports
  taskKey String? @unique

  /// Short imperative title
  title String

  /// Full explanation, deliverable, and acceptance criteria
  description String

  /// Optional "why this matters" copy
  impactStatement String?

  /// Optional role title when the task is addressed to a person or organization
  roleTitle String?

  /// Optional affiliation snapshot captured when the task was authored or reassigned
  assigneeAffiliationSnapshot String?

  /// Taxonomy for browsing and ranking
  category TaskCategory @default(OTHER)

  /// Estimated difficulty for matching
  difficulty TaskDifficulty @default(INTERMEDIATE)

  /// Estimated effort in hours for the person expected to complete the task
  estimatedEffortHours Float?

  /// Actual effort recorded when the task is completed without a claim row
  actualEffortSeconds Int?

  /// Actual cash cost recorded when the task is completed without a claim row
  actualCashCostUsd Float?

  /// Free-form skills needed for the task
  skillTags String[] @default([])

  /// Free-form topics / causes relevant to the task
  interestTags String[] @default([])

  /// Optional structured task context that does not justify first-class columns yet
  contextJson Json?

  /// Controls claimability
  claimPolicy TaskClaimPolicy @default(OPEN_SINGLE)

  /// Max simultaneous claims when claimPolicy is OPEN_MANY
  maxClaims Int?

  /// Current task status
  status TaskStatus @default(ACTIVE)

  /// Whether this task is visible in public accountability views
  isPublic Boolean @default(true)

  /// Curator-entered completion evidence for assigned-only/public tasks
  completionEvidence String?

  /// Earliest time this task should enter active personal queues
  availableAt DateTime?

  /// Optional due date or target completion date for accountability views
  dueAt DateTime?

  /// How dueAt affects personal scheduling and expiry behavior
  deadlinePolicy TaskDeadlinePolicy @default(NONE)

  /// When the task was completed
  completedAt DateTime?

  /// When the task was verified
  verifiedAt DateTime?

  /// Order within siblings when rendering task trees
  sortOrder Int @default(0)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  jurisdiction             Jurisdiction?               @relation(fields: [jurisdictionId], references: [id])
  parentTask               Task?                       @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks               Task[]                      @relation("TaskHierarchy")
  assigneePerson           Person?                     @relation("TaskAssigneePerson", fields: [assigneePersonId], references: [id], onDelete: SetNull)
  assigneeOrganization     Organization?               @relation("TaskAssigneeOrganization", fields: [assigneeOrganizationId], references: [id], onDelete: SetNull)
  verifiedByUser           User?                       @relation("TaskVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  owner                    User?                       @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  currentImpactEstimateSet TaskImpactEstimateSet?      @relation("CurrentTaskImpactEstimateSet", fields: [currentImpactEstimateSetId], references: [id], onDelete: SetNull)
  impactEstimateSets       TaskImpactEstimateSet[]     @relation("TaskImpactEstimateSets")
  claims                   TaskClaim[]                 @relation("TaskClaims")
  milestones               TaskMilestone[]             @relation("TaskMilestones")
  comments                 TaskComment[]               @relation("TaskComments")
  sourceArtifacts          TaskSourceArtifact[]        @relation("TaskSourceArtifacts")
  outgoingEdges            TaskEdge[]                  @relation("TaskOutgoingEdges")
  incomingEdges            TaskEdge[]                  @relation("TaskIncomingEdges")
  agentRunCosts            AgentRunCost[]              @relation("TaskAgentRunCosts")
  agentLeases              AgentTaskLease[]            @relation("TaskAgentLeases")
  shareAttempts            ShareAttempt[]              @relation("TaskShareAttempts")
  referralInvitations      ReferralInvitation[]        @relation("TaskReferralInvitations")
  communicationEndpoints   TaskCommunicationEndpoint[] @relation("TaskCommunicationEndpoints")
  communicationTemplates   TaskCommunicationTemplate[] @relation("TaskCommunicationTemplates")
  communications           TaskCommunication[]         @relation("TaskCommunications")

  @@index([jurisdictionId, status])
  @@index([parentTaskId])
  @@index([assigneePersonId])
  @@index([assigneeOrganizationId])
  @@index([verifiedByUserId])
  @@index([ownerUserId])
  @@index([claimPolicy, status])
  @@index([category])
  @@index([difficulty])
  @@index([availableAt])
  @@index([dueAt])
  @@index([deadlinePolicy, dueAt])
  @@index([ownerUserId, status, availableAt])
  @@index([isPublic])
  @@index([deletedAt])
}

/// A user's claim on a claimable task
model TaskClaim {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task being claimed
  taskId String

  /// User attempting the task
  userId String

  /// User who verified or rejected this claim
  verifiedByUserId String?

  /// Claim lifecycle status
  status TaskClaimStatus @default(CLAIMED)

  /// Evidence submitted by the claimant
  completionEvidence String?

  /// Optional reviewer note
  verificationNote String?

  /// Actual effort spent by the claimant
  actualEffortSeconds Int?

  /// Actual out-of-pocket cash cost reported by the claimant
  actualCashCostUsd Float?

  /// When the task was claimed
  claimedAt DateTime @default(now())

  /// When the claimant started working
  startedAt DateTime?

  /// When the claimant submitted completion
  completedAt DateTime?

  /// When the claim was verified or rejected
  verifiedAt DateTime?

  /// When the claim was abandoned
  abandonedAt DateTime?

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task           Task  @relation("TaskClaims", fields: [taskId], references: [id], onDelete: Cascade)
  user           User  @relation("UserTaskClaims", fields: [userId], references: [id], onDelete: Cascade)
  verifiedByUser User? @relation("TaskClaimVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, userId])
  @@index([taskId, status])
  @@index([userId, status])
  @@index([verifiedByUserId])
  @@index([deletedAt])
}

/// Canonical upstream artifact used to derive tasks or impact estimates
model SourceArtifact {
  /// Unique identifier
  id String @id @default(cuid())

  /// Source family that produced this artifact
  sourceSystem SourceSystem

  /// Artifact subtype
  artifactType SourceArtifactType

  /// Stable identity for imports and syncs
  sourceKey String @unique

  /// Optional external identifier from the upstream system
  externalKey String?

  /// Optional version key or snapshot id
  versionKey String?

  /// Human-readable label
  title String?

  /// Source URL for provenance
  sourceUrl String?

  /// Source reference / section id / slug
  sourceRef String?

  /// Hash of the artifact payload or content when available
  contentHash String?

  /// Structured upstream payload retained for reproducibility
  payloadJson Json?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  taskLinks                             TaskSourceArtifact[]                   @relation("TaskSourceArtifactLinks")
  impactLinks                           TaskImpactSourceArtifact[]             @relation("TaskImpactSourceArtifactLinks")
  globalVariableExternalCodes           GlobalVariableExternalCode[]           @relation("SourceArtifactGlobalVariableExternalCodes")
  personMemorialEvidence                PersonMemorialEvidence[]               @relation("SourceArtifactPersonMemorialEvidence")
  personMemorialResponsibleParties      PersonMemorialResponsibleParty[]       @relation("SourceArtifactPersonMemorialResponsibleParties")
  interventionApprovalTimelines         InterventionApprovalTimeline[]         @relation("SourceArtifactInterventionApprovalTimelines")
  interventionExperiences               InterventionExperience[]               @relation("SourceArtifactInterventionExperiences")
  variableRelationshipEvidenceEstimates VariableRelationshipEvidenceEstimate[] @relation("SourceArtifactVariableRelationshipEvidenceEstimates")
  interventionRankingRuns               InterventionRankingRun[]               @relation("SourceArtifactInterventionRankingRuns")

  @@index([sourceSystem, artifactType])
  @@index([externalKey])
  @@index([versionKey])
  @@index([sourceRef])
  @@index([contentHash])
  @@index([deletedAt])
}

/// A milestone representing progress toward completing a task
model TaskMilestone {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent task
  taskId String

  /// Stable milestone key within the task
  key String

  /// Short milestone title
  title String

  /// Optional explanatory detail
  description String?

  /// Current milestone status
  status TaskMilestoneStatus @default(NOT_STARTED)

  /// Optional supporting evidence URL
  evidenceUrl String?

  /// Optional curation / evidence note
  evidenceNote String?

  /// Display order within the task page
  sortOrder Int @default(0)

  /// When this milestone was completed
  completedAt DateTime?

  /// When this milestone was verified
  verifiedAt DateTime?

  /// User who verified this milestone
  verifiedByUserId String?

  /// Structured milestone metadata for domain-specific display
  metadataJson Json?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task           Task  @relation("TaskMilestones", fields: [taskId], references: [id], onDelete: Cascade)
  verifiedByUser User? @relation("TaskMilestoneVerifiedByUser", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskId, key])
  @@index([taskId, sortOrder])
  @@index([verifiedByUserId])
  @@index([status])
  @@index([deletedAt])
}

/// Readable task thread item: user comments, outgoing messages, inbound replies,
/// manual assignee responses, status notes, and agent/Wishonia posts.
model TaskComment {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task this comment belongs to
  taskId String

  /// Parent comment if this is a reply; null for top-level comments
  parentCommentId String?

  /// User who authored the comment (Wishonia is a regular User when present)
  authorUserId String?

  /// Person snapshot/record when the author is not a signed-in user
  authorPersonId String?

  /// Organization snapshot/record when the author is an external organization
  authorOrganizationId String?

  /// Display name captured at ingestion time for external/manual authors
  authorNameSnapshot String?

  /// Readable role of this thread item
  kind TaskCommentKind @default(COMMENT)

  /// Visibility for public vs internal coordination notes
  visibility TaskCommentVisibility @default(PUBLIC)

  /// Source that created or imported this row
  source TaskCommentSource @default(WEB)

  /// Markdown body. Supports GFM plus: $math$, $$block math$$, ```mermaid, ```chart
  message String

  /// Optional extra image / video / evidence URL beyond what's inline in the markdown
  mediaUrl String?

  /// Parsed @username mentions for future notification hooks
  mentionedUserIds String[] @default([])

  /// Cached upvote count — always written in the same transaction as vote changes
  upvoteCount Int @default(0)

  /// Cached downvote count
  downvoteCount Int @default(0)

  /// Derived score (upvoteCount - downvoteCount), used for Top sort
  voteScore Int @default(0)

  /// Cached reply count — incremented when a child comment is inserted
  replyCount Int @default(0)

  /// Reserved for future Hot sort algorithm; populated when Hot sort UI is added
  hotScore Float @default(0)

  /// Materialized path for fast subtree queries, e.g. "/parent-id/this-id"
  path String @default("")

  /// Structured citations (RAG sources) when the author is Wishonia or another agent
  citationsJson Json?

  /// When the message was last edited (null = not edited)
  editedAt DateTime?

  /// Soft-delete timestamp
  deletedAt DateTime?

  /// Whether a curator hid this comment
  hiddenByCurator Boolean @default(false)

  /// Reason the comment was moderated (if hidden)
  moderationReason String?

  /// User who moderated this comment
  moderatedByUserId String?

  /// When the comment was moderated
  moderatedAt DateTime?

  /// Integrity version counter — incremented on every update for reconciliation
  version Int @default(0)

  /// When this comment was created
  createdAt DateTime @default(now())

  /// When this comment was last updated
  updatedAt DateTime @updatedAt

  // -- Relations --
  task               Task                @relation("TaskComments", fields: [taskId], references: [id], onDelete: Cascade)
  parentComment      TaskComment?        @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies            TaskComment[]       @relation("CommentReplies")
  authorUser         User?               @relation("TaskCommentAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorPerson       Person?             @relation("TaskCommentAuthorPerson", fields: [authorPersonId], references: [id], onDelete: SetNull)
  authorOrganization Organization?       @relation("TaskCommentAuthorOrganization", fields: [authorOrganizationId], references: [id], onDelete: SetNull)
  moderatedBy        User?               @relation("TaskCommentModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  votes              TaskCommentVote[]   @relation("TaskCommentVotes")
  communications     TaskCommunication[] @relation("TaskCommentCommunications")

  @@index([taskId, createdAt])
  @@index([taskId, voteScore])
  @@index([taskId, hotScore])
  @@index([parentCommentId])
  @@index([authorUserId, createdAt])
  @@index([authorPersonId, createdAt])
  @@index([authorOrganizationId, createdAt])
  @@index([kind])
  @@index([visibility])
  @@index([source])
  @@index([deletedAt])
  @@index([path])
}

/// A user's vote on a task comment (+1 or -1)
model TaskCommentVote {
  /// Unique identifier
  id String @id @default(cuid())

  /// Comment being voted on
  commentId String

  /// User casting the vote
  userId String

  /// +1 for upvote, -1 for downvote
  value Int

  /// Hash of the voter's IP (for brigade detection, never displayed)
  ipHash String?

  /// Hash of the voter's user-agent (for sockpuppet detection)
  userAgentHash String?

  /// When the vote was cast
  createdAt DateTime @default(now())

  /// When the vote was last updated
  updatedAt DateTime @updatedAt

  // -- Relations --
  comment TaskComment @relation("TaskCommentVotes", fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("TaskCommentVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
  @@index([commentId, createdAt])
}

/// Link table connecting a task to one or more upstream artifacts
model TaskSourceArtifact {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task linked to the source artifact
  taskId String

  /// Upstream artifact used to derive the task
  sourceArtifactId String

  /// Whether this is the primary provenance artifact for the task
  isPrimary Boolean @default(false)

  /// When this link was created
  createdAt DateTime @default(now())

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task           Task           @relation("TaskSourceArtifacts", fields: [taskId], references: [id], onDelete: Cascade)
  sourceArtifact SourceArtifact @relation("TaskSourceArtifactLinks", fields: [sourceArtifactId], references: [id], onDelete: Cascade)

  @@unique([taskId, sourceArtifactId])
  @@index([taskId, isPrimary])
  @@index([sourceArtifactId, isPrimary])
  @@index([deletedAt])
}

/// Directed non-tree relationship between two tasks
model TaskEdge {
  /// Unique identifier
  id String @id @default(cuid())

  /// Supporting / upstream task
  fromTaskId String

  /// Downstream / affected task
  toTaskId String

  /// Causal or dependency edge type
  edgeType TaskEdgeType

  /// Low estimate of the probability lift produced by completing the upstream task
  probabilityDeltaLow Float?

  /// Base estimate of the probability lift produced by completing the upstream task
  probabilityDeltaBase Float?

  /// High estimate of the probability lift produced by completing the upstream task
  probabilityDeltaHigh Float?

  /// Low estimate of the number of days accelerated or delayed
  timeDeltaDaysLow Float?

  /// Base estimate of the number of days accelerated or delayed
  timeDeltaDaysBase Float?

  /// High estimate of the number of days accelerated or delayed
  timeDeltaDaysHigh Float?

  /// Version of the calculation logic used to derive this edge
  calculationVersion String?

  /// Structured assumptions used to derive this edge
  assumptionsJson Json?

  /// Optional notes or curation comments
  notes String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  fromTask Task @relation("TaskOutgoingEdges", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask   Task @relation("TaskIncomingEdges", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId, edgeType])
  @@index([fromTaskId, edgeType])
  @@index([toTaskId, edgeType])
  @@index([deletedAt])
}

/// Immutable run of impact calculations for a task
model TaskImpactEstimateSet {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task this estimate set belongs to
  taskId String

  /// Denormalized flag kept in sync with Task.currentImpactEstimateSetId for fast queries
  isCurrent Boolean @default(false)

  /// Whether this estimate is ex-ante, observed, or hybrid
  estimateKind TaskImpactEstimateKind

  /// Publication lifecycle for this estimate set
  publicationStatus TaskImpactPublicationStatus @default(DRAFT)

  /// Primary source family for the estimate set
  sourceSystem SourceSystem

  /// Version of the calculation logic used to build this estimate set
  calculationVersion String

  /// Methodology family or model key
  methodologyKey String

  /// Hash of the parameter set used to generate the estimate
  parameterSetHash String

  /// Counterfactual definition used for comparison
  counterfactualKey String

  /// Structured assumptions used to generate the estimate
  assumptionsJson Json?

  /// When this estimate set was created
  createdAt DateTime @default(now())

  /// When this estimate set was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task            Task                       @relation("TaskImpactEstimateSets", fields: [taskId], references: [id], onDelete: Cascade)
  currentForTask  Task?                      @relation("CurrentTaskImpactEstimateSet")
  frames          TaskImpactFrameEstimate[]  @relation("TaskImpactEstimateSetFrames")
  sourceArtifacts TaskImpactSourceArtifact[] @relation("TaskImpactEstimateSetSourceArtifacts")

  @@unique([taskId, estimateKind, sourceSystem, calculationVersion, methodologyKey, parameterSetHash, counterfactualKey])
  @@index([taskId, isCurrent])
  @@index([publicationStatus])
  @@index([sourceSystem])
  @@index([deletedAt])
}

/// Impact estimate for a specific evaluation frame
model TaskImpactFrameEstimate {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent estimate set
  taskImpactEstimateSetId String

  /// Named evaluation frame
  frameKey TaskImpactFrameKey

  /// Unique frame slug within the estimate set
  frameSlug String

  /// Optional label when frameKey is CUSTOM
  customFrameLabel String?

  /// Total horizon evaluated by this frame
  evaluationHorizonYears Float

  /// Delay from task completion to the start of impact
  timeToImpactStartDays Float

  /// Years required to reach full adoption / implementation
  adoptionRampYears Float

  /// Duration of benefits considered in this frame
  benefitDurationYears Float

  /// Annual discount rate used for present-value calculations
  annualDiscountRate Float

  /// Optional Monte Carlo summary statistics
  summaryStatsJson Json?

  /// Low estimate of eventual success probability
  successProbabilityLow Float?

  /// Base estimate of eventual success probability
  successProbabilityBase Float?

  /// High estimate of eventual success probability
  successProbabilityHigh Float?

  /// Low estimate of real after-tax median income growth effect
  medianIncomeGrowthEffectPpPerYearLow Float?

  /// Base estimate of real after-tax median income growth effect
  medianIncomeGrowthEffectPpPerYearBase Float?

  /// High estimate of real after-tax median income growth effect
  medianIncomeGrowthEffectPpPerYearHigh Float?

  /// Low estimate of median healthy life years effect
  medianHealthyLifeYearsEffectLow Float?

  /// Base estimate of median healthy life years effect
  medianHealthyLifeYearsEffectBase Float?

  /// High estimate of median healthy life years effect
  medianHealthyLifeYearsEffectHigh Float?

  /// Low estimate of expected DALYs averted over the frame
  expectedDalysAvertedLow Float?

  /// Base estimate of expected DALYs averted over the frame
  expectedDalysAvertedBase Float?

  /// High estimate of expected DALYs averted over the frame
  expectedDalysAvertedHigh Float?

  /// Low estimate of expected aggregate economic value over the frame
  expectedEconomicValueUsdLow Float?

  /// Base estimate of expected aggregate economic value over the frame
  expectedEconomicValueUsdBase Float?

  /// High estimate of expected aggregate economic value over the frame
  expectedEconomicValueUsdHigh Float?

  /// Low estimate of the cash cost to complete the task
  estimatedCashCostUsdLow Float?

  /// Base estimate of the cash cost to complete the task
  estimatedCashCostUsdBase Float?

  /// High estimate of the cash cost to complete the task
  estimatedCashCostUsdHigh Float?

  /// Low estimate of the effort required to complete the task
  estimatedEffortHoursLow Float?

  /// Base estimate of the effort required to complete the task
  estimatedEffortHoursBase Float?

  /// High estimate of the effort required to complete the task
  estimatedEffortHoursHigh Float?

  /// Low estimate of the DALYs lost per day of delay
  delayDalysLostPerDayLow Float?

  /// Base estimate of the DALYs lost per day of delay
  delayDalysLostPerDayBase Float?

  /// High estimate of the DALYs lost per day of delay
  delayDalysLostPerDayHigh Float?

  /// Low estimate of the aggregate economic value lost per day of delay
  delayEconomicValueUsdLostPerDayLow Float?

  /// Base estimate of the aggregate economic value lost per day of delay
  delayEconomicValueUsdLostPerDayBase Float?

  /// High estimate of the aggregate economic value lost per day of delay
  delayEconomicValueUsdLostPerDayHigh Float?

  /// When this frame was created
  createdAt DateTime @default(now())

  /// When this frame was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  taskImpactEstimateSet TaskImpactEstimateSet @relation("TaskImpactEstimateSetFrames", fields: [taskImpactEstimateSetId], references: [id], onDelete: Cascade)
  metrics               TaskImpactMetric[]    @relation("TaskImpactFrameEstimateMetrics")

  @@unique([taskImpactEstimateSetId, frameSlug])
  @@index([taskImpactEstimateSetId, frameKey])
  @@index([deletedAt])
}

/// Extensible metric attached to an impact frame
model TaskImpactMetric {
  /// Unique identifier
  id String @id @default(cuid())

  /// Impact frame this metric belongs to
  taskImpactFrameEstimateId String

  /// Stable metric identifier
  metricKey String

  /// Unit for display and interpretation
  unit String

  /// Low estimate value
  lowValue Float?

  /// Base estimate value
  baseValue Float?

  /// High estimate value
  highValue Float?

  /// Structured metric value for categorical or non-numeric metrics
  valueJson Json?

  /// Optional Monte Carlo summary statistics
  summaryStatsJson Json?

  /// Optional grouping label for UI presentation
  displayGroup String?

  /// Arbitrary structured metadata for this metric
  metadataJson Json?

  /// When this metric was created
  createdAt DateTime @default(now())

  /// When this metric was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  taskImpactFrameEstimate TaskImpactFrameEstimate @relation("TaskImpactFrameEstimateMetrics", fields: [taskImpactFrameEstimateId], references: [id], onDelete: Cascade)

  @@unique([taskImpactFrameEstimateId, metricKey])
  @@index([metricKey])
  @@index([displayGroup])
  @@index([deletedAt])
}

/// Link table connecting an impact estimate set to one or more upstream artifacts
model TaskImpactSourceArtifact {
  /// Unique identifier
  id String @id @default(cuid())

  /// Estimate set linked to the source artifact
  taskImpactEstimateSetId String

  /// Upstream artifact used to derive the impact estimate
  sourceArtifactId String

  /// Whether this is the primary provenance artifact for the estimate set
  isPrimary Boolean @default(false)

  /// When this link was created
