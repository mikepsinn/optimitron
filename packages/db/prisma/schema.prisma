  sourceArtifact        SourceArtifact        @relation("TaskImpactSourceArtifactLinks", fields: [sourceArtifactId], references: [id], onDelete: Cascade)

  @@unique([taskImpactEstimateSetId, sourceArtifactId])
  @@index([taskImpactEstimateSetId, isPrimary])
  @@index([sourceArtifactId, isPrimary])
  @@index([deletedAt])
}

// ============================================================================
// TASK COMMUNICATION SYSTEM
// ----------------------------------------------------------------------------
// TaskComment stores readable thread text. TaskCommunication stores the
// delivery/contact envelope across email, in-app, mailto, external URL/form,
// manual imports, and future channels. EmailLog remains provider-level email
// delivery detail.
// ============================================================================

/// Stored assignee contact method for a task.
model TaskCommunicationEndpoint {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task this endpoint belongs to
  taskId String

  /// Contact method type
  kind TaskCommunicationEndpointKind

  /// Human-readable label, e.g. "White House contact form"
  label String?

  /// URL for external pages/forms/profiles, or a mailto URL
  url String?

  /// Raw email address when the endpoint is email/mailto
  email String?

  /// Prewritten message instructions/template for this endpoint
  instructions String?

  /// Source used to discover or verify this endpoint
  sourceUrl String?

  /// Verification state of this endpoint
  verificationStatus TaskCommunicationEndpointVerificationStatus @default(UNVERIFIED)

  /// When this endpoint was last verified
  verifiedAt DateTime?

  /// Priority within the task's endpoint list; lower sorts first
  priority Int @default(0)

  /// Whether this is the primary endpoint shown in compact task cards
  isPrimary Boolean @default(false)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task           Task                @relation("TaskCommunicationEndpoints", fields: [taskId], references: [id], onDelete: Cascade)
  communications TaskCommunication[] @relation("TaskCommunicationEndpointCommunications")

  @@index([taskId])
  @@index([taskId, isPrimary])
  @@index([kind])
  @@index([verificationStatus])
  @@index([deletedAt])
}

/// Canonical strategy for communications about a task.
/// Keyed by (taskId, audience, purpose) - at most one active template per slot.
model TaskCommunicationTemplate {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task this template applies to
  taskId String

  /// Who receives messages from this template
  audience TaskCommunicationAudience

  /// Lifecycle purpose of the template (INVITATION / REMINDER / SCORECARD / etc.)
  purpose TaskCommunicationPurpose

  /// Optional human label for admin/debug surfaces (e.g. "Treaty B3 Sender Reminder")
  label String?

  /// Whether the engine should select from this template
  isActive Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task           Task                       @relation("TaskCommunicationTemplates", fields: [taskId], references: [id], onDelete: Cascade)
  variants       TaskCommunicationVariant[] @relation("TaskCommunicationTemplateVariants")
  communications TaskCommunication[]        @relation("TaskCommunicationTemplateCommunications")

  @@unique([taskId, audience, purpose])
  @@index([taskId])
  @@index([audience, purpose])
  @@index([isActive])
  @@index([deletedAt])
}

/// A specific subject/body variant within a TaskCommunicationTemplate.
/// Keyed by (templateId, step, format) so variants can express step-by-step
/// sequences AND format branches (e.g. TASK_NOTIFICATION vs SINCERE).
model TaskCommunicationVariant {
  /// Unique identifier
  id String @id @default(cuid())

  /// The template this variant belongs to
  templateId String

  /// Step number within the sequence (0 for one-shot, 1..N for multi-step)
  step Int @default(0)

  /// Format / style branch (DEFAULT for templates that do not branch)
  format TaskCommunicationFormat @default(DEFAULT)

  /// Subject line
  subject String?

  /// Rendered HTML body (or template body if rendering happens at send time)
  htmlBody String?

  /// Plain-text body
  textBody String?

  /// Days to wait after the prior step before sending this one
  delayDays Int?

  /// Display name used in the From header (e.g. "Wishonia, PMO")
  senderIdentity String?

  /// Signature block appended to the body
  signature String?

  /// Footer text (e.g. unsubscribe disclosure, list-unsubscribe address)
  footer String?

  /// Email scope used for suppression / unsubscribe routing
  unsubscribeScope String?

  /// Whether this variant is currently eligible for selection
  isActive Boolean @default(true)

  /// Variant selection weight when multiple variants share (templateId, step, format)
  /// in future A/B configurations. Engine picks weighted-random among active.
  weight Float @default(1.0)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  template       TaskCommunicationTemplate @relation("TaskCommunicationTemplateVariants", fields: [templateId], references: [id], onDelete: Cascade)
  communications TaskCommunication[]       @relation("TaskCommunicationVariantCommunications")
  shareAttempts  ShareAttempt[]            @relation("ShareAttemptTaskCommunicationVariant")

  @@unique([templateId, step, format])
  @@index([templateId])
  @@index([isActive])
  @@index([deletedAt])
}

/// Per-recipient or per-endpoint communication state. Replaces the
/// email-sequence columns currently overloaded onto `ReferralInvitation`,
/// task-level contact columns, and Activity-only contact records.
model TaskCommunication {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task this communication is about
  taskId String

  /// Readable thread item shown to users/agents
  taskCommentId String?

  /// Template that drove the communication, if any
  templateId String?

  /// The exact variant rendered (records exact step/format at send time)
  templateVariantId String?

  /// Endpoint used for external assignee contact, if any
  endpointId String?

  /// Optional Person record for the recipient (preferred over raw email when present)
  recipientPersonId String?

  /// Optional User if the recipient is a known signed-in user
  recipientUserId String?

  /// Optional Organization if the recipient is an external org
  recipientOrganizationId String?

  /// Recipient email captured at send time
  recipientEmail String?

  /// Recipient display name captured at send/import time
  recipientNameSnapshot String?

  /// Optional User who sent/initiated the communication
  senderUserId String?

  /// Optional Person who sent/initiated the communication
  senderPersonId String?

  /// Sender display name captured at send/import time
  senderNameSnapshot String?

  /// Audience (denormalized snapshot of template.audience for fast filtering)
  audience TaskCommunicationAudience

  /// Purpose (denormalized snapshot of template.purpose)
  purpose TaskCommunicationPurpose

  /// Outbound or inbound
  direction TaskCommunicationDirection @default(OUTBOUND)

  /// Channel used by this envelope
  channel TaskCommunicationChannel @default(EMAIL)

  /// Format used for this communication
  format TaskCommunicationFormat @default(DEFAULT)

  /// Step in the sequence this communication represents
  step Int @default(0)

  /// When the next send for this recipient/purpose lineage is scheduled
  nextSendAt DateTime?

  /// When the communication was sent/opened/initiated
  sentAt DateTime?

  /// When an inbound communication/manual response was received
  receivedAt DateTime?

  /// When a communication failed
  failedAt DateTime?

  /// When a communication was cancelled/suppressed
  cancelledAt DateTime?

  /// Per-communication unsubscribe token for one-click opt-out (when audience requires it)
  unsubscribeToken String? @unique

  /// Linked ShareAttempt for the outbound-message ledger
  shareAttemptId String?

  /// Linked EmailLog if this attempt produced a tracked email send
  emailLogId String?

  /// Optional ReferralInvitation this attempt is associated with (named-invite sequences)
  referralInvitationId String?

  /// Lifecycle status
  status TaskCommunicationStatus @default(DRAFT)

  /// External URL/mailto target or provider-facing URL snapshot
  externalUrl String?

  /// Error message captured on failed sends
  errorMessage String?

  /// Provider's message id (e.g., Resend)
  providerMessageId String?

  /// Free-form metadata for channel-specific details (openedAt, submittedAt, subject pick, etc.)
  metadataJson Json?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  task                  Task                       @relation("TaskCommunications", fields: [taskId], references: [id], onDelete: Cascade)
  taskComment           TaskComment?               @relation("TaskCommentCommunications", fields: [taskCommentId], references: [id], onDelete: SetNull)
  template              TaskCommunicationTemplate? @relation("TaskCommunicationTemplateCommunications", fields: [templateId], references: [id], onDelete: SetNull)
  templateVariant       TaskCommunicationVariant?  @relation("TaskCommunicationVariantCommunications", fields: [templateVariantId], references: [id], onDelete: SetNull)
  endpoint              TaskCommunicationEndpoint? @relation("TaskCommunicationEndpointCommunications", fields: [endpointId], references: [id], onDelete: SetNull)
  recipientPerson       Person?                    @relation("TaskCommunicationRecipientPerson", fields: [recipientPersonId], references: [id], onDelete: SetNull)
  recipientUser         User?                      @relation("TaskCommunicationRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  recipientOrganization Organization?              @relation("TaskCommunicationRecipientOrganization", fields: [recipientOrganizationId], references: [id], onDelete: SetNull)
  senderUser            User?                      @relation("TaskCommunicationSenderUser", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderPerson          Person?                    @relation("TaskCommunicationSenderPerson", fields: [senderPersonId], references: [id], onDelete: SetNull)
  shareAttempt          ShareAttempt?              @relation("ShareAttemptTaskCommunications", fields: [shareAttemptId], references: [id], onDelete: SetNull)
  emailLog              EmailLog?                  @relation("EmailLogTaskCommunications", fields: [emailLogId], references: [id], onDelete: SetNull)
  referralInvitation    ReferralInvitation?        @relation("ReferralInvitationTaskCommunications", fields: [referralInvitationId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([taskCommentId])
  @@index([templateId])
  @@index([templateVariantId])
  @@index([endpointId])
  @@index([recipientPersonId])
  @@index([recipientUserId])
  @@index([recipientOrganizationId])
  @@index([senderUserId])
  @@index([senderPersonId])
  @@index([nextSendAt])
  @@index([status])
  @@index([channel])
  @@index([purpose])
  @@index([referralInvitationId])
  @@index([emailLogId])
  @@index([deletedAt])
}

// ============================================================================
// TASK TRIGGER FRAMEWORK
// ============================================================================
// Generalized data-driven framework that subsumes hardcoded task-spawn,
// task-verify, and task-communication patterns. A TaskTrigger row is the
// blueprint; fireTaskTrigger(triggerKey, context) is the runtime entrypoint.
// AI agents can author triggers over MCP without source-code commits.

/// A configurable rule that fires on an event and either spawns tasks,
/// verifies a task, or spawns a communication.
///
/// Usage: code/cron/MCP-tool fires `fireTaskTrigger(triggerKey, context)`.
/// Runtime looks up this row, applies eventFilter, computes idempotencyKey
/// via template substitution, checks TaskTriggerFire for a prior fire with
/// that key, and either returns the prior result or executes spawnSpecs.
model TaskTrigger {
  /// Unique identifier
  id String @id @default(cuid())

  /// Stable cross-deploy key. Examples:
  ///   "user-onboarding:treaty"
  ///   "treaty:signer-reminder"
  ///   "referral:vote-invitation"
  ///   "task:overdue-reminder"
  triggerKey String @unique

  /// Free-form event name. Convention: "<source>.<verb>" or "<source>.<verb>.<qualifier>".
  /// Examples: "user.signup", "task.statusChanged.VERIFIED", "referral.sent",
  /// "cron.<name>", "mcp.<toolName>", "manual", "dataset.recordChanged.<source>".
  eventName String

  /// Optional JSON filter applied to event context to narrow which instances
  /// fire this trigger. Operators: equals, matches, and, or, not, exists.
  /// Empty/null = no filter, fires for every event of eventName.
  eventFilter Json?

  /// What the trigger does when it fires. String, not enum, so future
  /// kinds need no migration. Runtime maps the string to a handler.
  ///   "spawnTasks"         — creates tasks per spawnSpecs
  ///   "verifyTask"         — marks an existing task VERIFIED
  ///   "spawnCommunication" — creates TaskComment/TaskCommunication
  triggerKind String @default("spawnTasks")

  /// Whether this trigger is currently active. Soft-pause without delete.
  enabled Boolean @default(true)

  /// Optional human-readable explanation if disabled.
  disabledReason String?

  /// Idempotency key TEMPLATE. Computed against event context with {{token}}
  /// substitution. Result is the unique identifier for one fire of this
  /// trigger — written to TaskTriggerFire.idempotencyKey, and (for spawnTasks)
  /// also forms the base of the spawned task's taskKey.
  idempotencyKeyTemplate String

  /// Optional completion gate. When present and `triggerKind=spawnTasks`,
  /// the spawned parent task auto-VERIFIES when the gate condition holds
  /// against its child task statuses. Spec is JSON for forward compat:
  ///   { "kind": "allOf",  "subtaskKinds": [...] }
  ///   { "kind": "anyOf",  "subtaskKinds": [...] }
  ///   { "kind": "count",  "minVerified": N, "scope": "children" }
  ///   { "kind": "always", "evidenceTemplate": "..." }
  completionGate Json?

  /// Optional jurisdiction scope. NULL = global / cross-jurisdiction.
  jurisdictionId String?

  /// Optional cron schedule expression (e.g. "30 * * * *" for every hour at :30).
  /// When set, the /api/cron/run-due-triggers handler fires this trigger
  /// whenever the schedule is due since the last successful fire. NULL = the
  /// trigger only fires via explicit event publication (post-signin, MCP,
  /// referral.sent, etc.) and is not driven by cron.
  schedule String?

  /// Optional iteration-source resolver key. Tells the cron handler what
  /// data to iterate over before firing the trigger per record. The
  /// resolver runs and the trigger is fired once per yielded record with
  /// the record injected as `context.<key>`. NULL or "none" = single fire,
  /// no iteration. Recognized keys live in
  /// packages/web/src/lib/triggers/iteration-sources.ts.
  ///   "none"           — fire once, no records (good for fan-out tasks)
  ///   "overdue-tasks"  — iterate Task rows past dueAt with status != VERIFIED
  iterationSource String?

  /// Free-form notes for human editors / AI agents.
  notes String?

  /// Forward-compat escape hatch: arbitrary metadata that doesn't justify
  /// a first-class column. Use sparingly; prefer adding columns when a
  /// pattern stabilizes.
  metadata Json?

  /// Audit: who created/last-edited.
  createdByUserId String?
  updatedByUserId String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete (preferred over hard delete to preserve fire-log foreign key)
  deletedAt DateTime?

  // -- Relations --
  spawnSpecs              TaskSpawnSpec[]              @relation("TaskTriggerSpawnSpecs")
  communicationSpawnSpecs TaskCommunicationSpawnSpec[] @relation("TaskTriggerCommunicationSpawnSpecs")
  fires                   TaskTriggerFire[]            @relation("TaskTriggerFires")
  jurisdiction            Jurisdiction?                @relation("JurisdictionTaskTriggers", fields: [jurisdictionId], references: [id], onDelete: SetNull)

  @@index([eventName, enabled])
  @@index([jurisdictionId, eventName])
  @@index([deletedAt])
}

/// One spawn spec = one task that gets created when a TaskTrigger fires.
/// A trigger may have multiple specs to model parent + children together
/// (e.g., onboarding tree spawns 1 parent + 5 subtasks in one fire).
model TaskSpawnSpec {
  /// Unique identifier
  id String @id @default(cuid())

  /// Owning trigger
  triggerId String

  /// Suffix used in the spawned task's taskKey to distinguish siblings.
  /// e.g. "shareReferralUrl", "phoneScript", "assignFirstHuman".
  /// The full taskKey is `<trigger.idempotencyKey>:<kind>` (or just the
  /// idempotencyKey for the parent spec).
  kind String

  /// Whether this is the parent task in the spawn group. At most one
  /// per trigger. If absent, all specs are siblings (no parent created).
  isParent Boolean @default(false)

  /// Display order within the spawn group.
  sortOrder Int @default(0)

  // -- Templated content --
  /// Title template. Supports {{path.to.field}} substitution.
  titleTemplate String

  /// Description template. Multi-line OK.
  descriptionTemplate String

  /// Optional impact statement template.
  impactStatementTemplate String?

  /// Role title template (e.g. "Humanity Manager", "Referred treaty voter").
  roleTitleTemplate String?

  // -- Static defaults --
  category             TaskCategory   @default(OTHER)
  difficulty           TaskDifficulty @default(TRIVIAL)
  estimatedEffortHours Float?

  /// Days from now until dueAt. NULL = no due date.
  dueDays Float?

  /// Days from now until availableAt (deferred start). NULL = available immediately.
  availableInDays Float?

  /// Deadline policy. String for forward-compat.
  ///   "NONE" | "SOFT" | "EXPIRES" | "REQUIRED"
  deadlinePolicy String?

  claimPolicy TaskClaimPolicy @default(ASSIGNED_ONLY)

  /// Whether the spawned task is publicly visible.
  isPublic Boolean @default(false)

  /// Skill / interest tags. Strings; templates run on each entry.
  skillTagTemplates    String[]
  interestTagTemplates String[]

  // -- Action link template --
  actionLinkUrlTemplate          String?
  actionLinkLabelTemplate        String?
  actionLinkInstructionsTemplate String?

  // -- Resolvers (string keys → runtime registry) --
  /// Who owns the spawned task.
  ///   "actor" | "context.<path>" | "system"
  ownerResolver String @default("actor")

  /// Who is assigned (Person row).
  ///   "actor" | "context.recipient" | "lookup.byEmail" | "lookup.byHandle" | "none"
  assigneePersonResolver String @default("none")

  /// Who is assigned (Organization).
  ///   "context.organization" | "none"
  assigneeOrganizationResolver String @default("none")

  /// Parent task source.
  ///   "trigger.parentSpec" | "context.parentTaskId" | "fixed:<taskKey>" | "none"
  parentResolver String @default("trigger.parentSpec")

  /// Whether this spec contributes to the trigger's completionGate.
  contributesToGate Boolean @default(false)

  /// Free-form bag.
  metadata Json?

  // -- Relations --
  trigger TaskTrigger @relation("TaskTriggerSpawnSpecs", fields: [triggerId], references: [id], onDelete: Cascade)

  @@unique([triggerId, kind])
  @@index([triggerId, sortOrder])
}

/// One communication spawn spec = one TaskComment + TaskCommunication
/// entity created when a TaskTrigger of kind="spawnCommunication" fires.
/// Used for cron-driven outreach (overdue reminders), comment-on-event,
/// and any "platform sends a message about a task" flow.
model TaskCommunicationSpawnSpec {
  /// Unique identifier
  id String @id @default(cuid())

  /// Owning trigger
  triggerId String

  /// Suffix used in the dedupeKey for the spawned TaskCommunication.
  /// e.g. "overdue-reminder", "delayed-day-7"
  kind String

  sortOrder Int @default(0)

  // -- Templated content --
  /// Email subject template.
  subjectTemplate String

  /// Plain-text body template.
  bodyTextTemplate String

  /// Optional HTML body template. If null, the runtime renders text-only.
  bodyHtmlTemplate String?

  /// Optional STATUS_UPDATE comment to attach alongside the communication.
  commentTemplate String?

  // -- Routing --
  /// "EMAIL" | "IN_APP" | "PUSH" | future channels — string for forward-compat.
  channel String @default("EMAIL")

  /// "ASSIGNEE" | "OWNER" | "WATCHERS" | "context.recipientUserIds" — resolver key.
  audienceResolver String @default("ASSIGNEE")

  /// "REMINDER" | "ANNOUNCEMENT" | "STATUS_UPDATE" — string for forward-compat.
  purpose String @default("REMINDER")

  /// Email scope key (used to honor unsubscribes). e.g. "task-reminders".
  emailScope String?

  // -- Rate-limit / dedup --
  /// Deduplication key template. Prevents the same communication from
  /// being sent twice (e.g. "task-overdue-reminder:{{task.id}}:{{sendCount}}").
  dedupeKeyTemplate String

  /// Minimum hours between fires to the same recipient on this trigger.
  /// 0 = no cooldown.
  minHoursBetweenSends Float @default(0)

  /// Maximum total sends across the lifetime of the addressed task.
  /// 0 = unlimited.
  maxSendsPerTask Int @default(0)

  /// Inclusive lower bound on the prior-send count at which this spec is
  /// active. Lets a single trigger carry escalating-tone variants — e.g.
  /// kind="week-1" with minSendCount=0/maxSendCount=0, kind="week-2" with
  /// minSendCount=1/maxSendCount=1, kind="week-3-final" with
  /// minSendCount=2/maxSendCount=null (open-ended).
  minSendCount Int @default(0)

  /// Inclusive upper bound on the prior-send count at which this spec is
  /// active. NULL = open-ended (this spec keeps firing once we've reached
  /// minSendCount, until maxSendsPerTask runs out).
  maxSendCount Int?

  /// Free-form bag.
  metadata Json?

  // -- Relations --
  trigger TaskTrigger @relation("TaskTriggerCommunicationSpawnSpecs", fields: [triggerId], references: [id], onDelete: Cascade)

  @@unique([triggerId, kind])
  @@index([triggerId, sortOrder])
}

/// Audit log of every TaskTrigger fire. Provides idempotency (don't
/// double-fire), debugging, and analytics. Source of truth for "what
/// happened, when, with what context."
model TaskTriggerFire {
  /// Unique identifier
  id String @id @default(cuid())

  /// Owning trigger
  triggerId String

  /// Computed idempotency key for this fire.
  idempotencyKey String

  /// Who fired (when applicable). NULL for cron / system fires.
  actorUserId String?

  /// Snapshot of the context at fire time.
  context Json

  /// Result code. String, not enum, for forward compat.
  ///   "spawned"      — created N tasks
  ///   "alreadyFired" — found prior fire with same idempotencyKey, returned cached IDs
  ///   "filteredOut"  — eventFilter rejected the event
  ///   "verified"     — marked a task VERIFIED
  ///   "communicated" — TaskComment/TaskCommunication created
  ///   "rateLimited"  — communication path: cooldown or max-sends prevented send
  ///   "failed"       — runtime error
  result String

  /// Error message when result=failed.
  error String?

  /// Tasks (or other entities) produced by this fire.
  spawnedTaskKeys String[]
  spawnedTaskIds  String[]

  /// When this fire occurred.
  firedAt DateTime @default(now())

  // -- Relations --
  trigger TaskTrigger @relation("TaskTriggerFires", fields: [triggerId], references: [id], onDelete: Cascade)

  @@unique([triggerId, idempotencyKey])
  @@index([triggerId, firedAt])
  @@index([actorUserId, firedAt])
  @@index([result, firedAt])
}

// ============================================================================
// SURVEY SYSTEM
// ============================================================================

/// A survey for collecting structured feedback, outcome data, or knowledge assessments
model Survey {
  /// Unique identifier
  id String @id @default(cuid())

  /// Survey title
  title String

  /// URL-safe slug
  slug String @unique

  /// Description of the survey's purpose
  description String?

  /// Optional jurisdiction scope
  jurisdictionId String?

  /// Optional link to a referendum
  referendumId String?

  /// Whether the survey is currently accepting responses
  active Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  jurisdiction Jurisdiction?    @relation(fields: [jurisdictionId], references: [id])
  referendum   Referendum?      @relation(fields: [referendumId], references: [id])
  sections     SurveySection[]
  responses    SurveyResponse[]

  @@index([slug])
  @@index([jurisdictionId])
  @@index([referendumId])
  @@index([active])
}

/// A section within a survey (groups related questions)
model SurveySection {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent survey
  surveyId String

  /// Section title
  title String

  /// Optional description
  description String?

  /// Display order within the survey
  sortOrder Int @default(0)

  /// JSON-encoded conditional display rules (e.g. show only if Q1 = "yes")
  conditionalLogic String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  survey    Survey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]

  @@unique([surveyId, sortOrder])
  @@index([surveyId])
  @@index([deletedAt])
}

/// A single question within a survey section
model SurveyQuestion {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent section
  sectionId String

  /// Question text
  text String

  /// Type of question
  type QuestionType

  /// Whether this question must be answered
  required Boolean @default(false)

  /// JSON-encoded options for MULTIPLE_CHOICE (e.g. ["A","B","C"])
  options String?

  /// Display order within the section
  sortOrder Int @default(0)

  /// Points awarded for correct answer (for knowledge-gated voting)
  score Float?

  /// JSON-encoded conditional display rules
  conditionalLogic String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  section   SurveySection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  @@unique([sectionId, sortOrder])
  @@index([sectionId])
  @@index([deletedAt])
}

/// A user's overall response to a survey
model SurveyResponse {
  /// Unique identifier
  id String @id @default(cuid())

  /// Which survey this response is for
  surveyId String

  /// The user who submitted the response
  userId String

  /// Organization context for partner-hosted survey or embed attribution
  organizationId String?

  /// Total score (for knowledge assessments)
  totalScore Float?

  /// When this response was submitted
  completedAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  // -- Relations --
  survey       Survey             @relation(fields: [surveyId], references: [id])
  user         User               @relation("UserSurveyResponses", fields: [userId], references: [id], onDelete: Cascade)
  organization Organization?      @relation("OrganizationSurveyResponses", fields: [organizationId], references: [id])
  answers      QuestionResponse[]

  @@unique([surveyId, userId])
  @@index([surveyId])
  @@index([userId])
  @@index([organizationId])
}

/// A single question answer within a survey response
model QuestionResponse {
  /// Unique identifier
  id String @id @default(cuid())

  /// Parent survey response
  surveyResponseId String

  /// The question being answered
  questionId String

  /// The answer value (text for free-text, selected option for MC, number as string for numeric/rating)
  answer String

  /// Score awarded for this answer
  score Float?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  surveyResponse SurveyResponse @relation(fields: [surveyResponseId], references: [id], onDelete: Cascade)
  question       SurveyQuestion @relation(fields: [questionId], references: [id])

  @@unique([surveyResponseId, questionId])
  @@index([surveyResponseId])
  @@index([questionId])
  @@index([deletedAt])
}

// ============================================================================
// GAMIFICATION & SOCIAL
// ============================================================================

/// Achievement badge earned by a user
model Badge {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who earned this badge
  userId String

  /// Badge type
  type BadgeType

  /// When the badge was earned
  earnedAt DateTime @default(now())

  /// Optional metadata (e.g. which comparison was the 100th)
  metadata String?

  // -- Relations --
  user User @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
}

/// A wish reward granted for a specific user action.
/// Balance = SUM(amount) per user. No cached balance field — always computed.
model WishPoint {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who earned these wishes
  userId String

  /// Number of wishes granted (always positive)
  amount Int

  /// What action earned these wishes
  reason WishReason

  /// Optional link to the Activity that triggered this grant
  activityId String?

  /// JSON-encoded context (e.g. referendumId, depositAmount)
  metadata String?

  /// When this grant was created
  createdAt DateTime @default(now())

  // -- Relations --
  user     User      @relation("UserWishPoints", fields: [userId], references: [id], onDelete: Cascade)
  activity Activity? @relation("WishPointActivity", fields: [activityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([reason])
}

/// Linked social/wallet account for a user
model SocialAccount {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user who owns this linked account
  userId String

  /// Platform identifier
  platform SocialPlatform

  /// Platform-specific account ID
  accountId String?

  /// Platform username / handle
  username String?

  /// Wallet address (for ETHEREUM, BASE platforms)
  walletAddress String?

  /// Whether this is the user's primary account for this platform
  isPrimary Boolean @default(false)

  /// When the account was verified
  verifiedAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp; non-null means this record is logically deleted
  deletedAt DateTime?

  // -- Relations --
  user User @relation("UserSocialAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([walletAddress])
  @@index([deletedAt])
}

/// Email delivery tracking log
model EmailLog {
  /// Unique identifier
  id String @id @default(cuid())

  /// The user this email was sent to, when the recipient has an account
  userId String?

  /// Email address it was sent to
  toAddress String

  /// Email subject line (as-sent, rendered)
  subject String

  /// Template or category identifier (e.g. "referral_sequence_0", "referendum_milestone")
  templateId String?

  /// Resend (or other provider) message ID, returned from the send API.
  /// Used to match incoming webhook events back to this row.
  providerMessageId String?

  /// Human-readable ID of the subject variant picked by the selector
  subjectVariantId String?

  /// Raw subject template string (grouping key that survives ID renames).
  /// The rendered subject is already stored in `subject`.
  subjectTemplate String?

  /// Human-readable ID of the body template picked by the selector.
  /// The raw body template string + rendered message live on related ShareAttempt rows
  /// (one per share channel), so no need to duplicate here.
  bodyTemplateId String?

  /// JSON snapshot of the send context at render time:
  /// { step, countryCode, referralCount, presidentSlug, daysSinceSignup, ... }
  sendContext Json?

  /// Delivery status
  status EmailLogStatus @default(SENT)

  /// When the email was sent
  sentAt DateTime @default(now())

  /// When it was delivered (from webhook)
  deliveredAt DateTime?

  /// When it was opened (from tracking pixel)
  openedAt DateTime?

  /// When it bounced (from webhook)
  bouncedAt DateTime?

  /// Error message if failed/bounced
  errorMessage String?

  /// Optional dedupe key for emails that are not tied to a User row
  dedupeKey String? @unique

  /// When this record was created
  createdAt DateTime @default(now())

  // -- Relations --
  user               User?               @relation("UserEmailLogs", fields: [userId], references: [id], onDelete: SetNull)
  shareAttempts      ShareAttempt[]      @relation("EmailLogShareAttempts")
  taskCommunications TaskCommunication[] @relation("EmailLogTaskCommunications")

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
  @@index([providerMessageId])
  @@index([subjectVariantId])
  @@index([bodyTemplateId])
  @@index([status])
  @@index([sentAt])
}

/// A single outbound share message (email-button press or in-app share). The
/// canonical unit for cross-channel attribution. Embedded in `/r/{code}?sa={id}`
/// on the referral URL inside the rendered message, so recipient clicks can
/// be tied back to the template that generated the share.
model ShareAttempt {
  /// Pre-generated cuid2 (client- or server-generated BEFORE insert so the id
  /// can be embedded in the outbound URL).
  id String @id

  /// The sharer
  userId String

  /// Channel surface: EMAIL (pre-created when an email is built) or IN_APP.
  source ShareSource

  /// Component/surface that produced the share, e.g.
  /// "referral_email", "task_row_share", "post_vote_reminders".
  surface String?

  /// Share platform: "x", "bluesky", "linkedin", "facebook", "reddit", "email", "copy-link", etc.
  channel String?

  /// Task this share is about, if applicable
  taskId String?

  /// Email that produced this share (non-null when source=EMAIL)
  emailLogId String?

  /// Human label of the share template used (e.g. "lumbergh").
  templateId String?

  /// Optional FK to the typed `TaskCommunicationVariant` that produced this share.
  /// Coexists with `templateId` (free-form label) during the migration window;
  /// once Phase B engine is the only writer, this becomes the canonical link.
  taskCommunicationVariantId String?

  /// sha256(templateBody) — primary grouping key for analytics (survives renames).
  templateHash String?

  /// Raw template string with {tokens} — for replay / inspection.
  templateBody String?

  /// Exact final message content the user saw / sent (per-sender; forensics).
  renderedMessage String?

  /// sha256(renderedMessage) — lets us group by exact-sent content.
  renderedHash String?

  /// True if the user edited the textarea before sharing (in-app only signals this).
  wasEdited Boolean @default(false)

  /// Send-time context snapshot for cohort analysis later.
  context Json?

  /// Set by /r/[code] the first time a recipient clicks through with this sa=.
  /// Distinguishes "potential" (pre-created) shares from "activated" ones.
  firstReferralClickAt DateTime?

  /// When this row was created
  createdAt DateTime @default(now())

  // -- Relations --
  user                     User                      @relation("UserShareAttempts", fields: [userId], references: [id], onDelete: Cascade)
  emailLog                 EmailLog?                 @relation("EmailLogShareAttempts", fields: [emailLogId], references: [id], onDelete: SetNull)
  task                     Task?                     @relation("TaskShareAttempts", fields: [taskId], references: [id], onDelete: SetNull)
  taskCommunicationVariant TaskCommunicationVariant? @relation("ShareAttemptTaskCommunicationVariant", fields: [taskCommunicationVariantId], references: [id], onDelete: SetNull)
  referralInvitations      ReferralInvitation[]      @relation("ShareAttemptReferralInvitations")
  taskCommunications       TaskCommunication[]       @relation("ShareAttemptTaskCommunications")

  @@index([userId, createdAt])
  @@index([templateHash])
  @@index([emailLogId])
  @@index([taskCommunicationVariantId])
  @@index([firstReferralClickAt])
  @@index([source])
  @@index([channel])
}

// ────────────────────────────────────────────────────────────
// Agent Compute Funding
// ────────────────────────────────────────────────────────────

enum AgentComputeDepositSource {
  STRIPE
  CRYPTO
  MANUAL
}

enum AgentRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

/// A deposit that funds autonomous agent compute
model AgentComputeDeposit {
  /// Unique identifier
  id String @id @default(cuid())

  /// Amount deposited in USD
  amountUsd Float

  /// Where the deposit came from
  source AgentComputeDepositSource

  /// External reference (Stripe payment ID, tx hash, etc.)
  externalRef String?

  /// Optional memo from depositor
  memo String?

  /// How much of this deposit has been spent on agent runs
  spentUsd Float @default(0)

  /// The user who made the deposit (null for anonymous crypto deposits)
  depositorUserId String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  depositorUser User?          @relation("UserAgentComputeDeposits", fields: [depositorUserId], references: [id], onDelete: SetNull)
  agentRunCosts AgentRunCost[] @relation("DepositAgentRunCosts")

  @@index([depositorUserId])
  @@index([source])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Cost record for a single agent run, linking spend to impact
model AgentRunCost {
  /// Unique identifier
  id String @id @default(cuid())

  /// Agent run identifier (matches AgentRunLog.runId)
  runId String

  /// AI provider used (gemini, anthropic, openai, etc.)
  provider String

  /// Total cost in USD for this run
  costUsd Float

  /// Number of API calls made
  apiCalls Int

  /// Run status
  status AgentRunStatus @default(RUNNING)

  /// Optional link to the task this run worked on
  taskId String?

  /// Optional link to the deposit that funded this run
  depositId String?

  /// Summary of what the run produced
  outputSummary String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  // -- Relations --
  task    Task?                @relation("TaskAgentRunCosts", fields: [taskId], references: [id], onDelete: SetNull)
  deposit AgentComputeDeposit? @relation("DepositAgentRunCosts", fields: [depositId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([taskId])
  @@index([depositId])
  @@index([provider])
  @@index([createdAt])
}

/// Short-lived agent lease on a task. Prevents multiple agents from working the
/// same task simultaneously. Separate from TaskClaim (which tracks human work
/// completion semantics).
model AgentTaskLease {
  /// Unique identifier
  id String @id @default(cuid())

  /// Task being worked on
  taskId String

  /// Agent identity (user ID, agent name, or run ID)
  agentId String

  /// When the lease expires — agent must heartbeat before this time
  expiresAt DateTime

  /// Last heartbeat received
  lastHeartbeatAt DateTime @default(now())

  /// Whether the lease is still active
  released Boolean @default(false)

  /// When the lease was created
  createdAt DateTime @default(now())

  /// When the lease was released or expired
  releasedAt DateTime?

  // -- Relations --
  task Task @relation("TaskAgentLeases", fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, agentId])
  @@index([taskId, released, expiresAt])
  @@index([agentId])
  @@index([expiresAt])
}

// ============================================================================
// OAuth — MCP Remote Server Authentication
// ============================================================================

/// OAuth client registered via MCP dynamic client registration.
/// Persisted so we can show "Connected Apps" in user settings and support
/// multiple apps (Claude Desktop, custom agents, third-party integrations).
model OAuthClient {
  /// Internal primary key
  id String @id @default(cuid())

  /// Public client identifier issued during registration
  clientId String @unique @default(cuid())

  /// Human-readable client name shown in consent UI
  clientName String?

  /// Allowed redirect URIs for the authorization flow
  redirectUris String[]

  /// Allowed grant types (default: authorization_code, refresh_token)
  grantTypes String[] @default(["authorization_code", "refresh_token"])

  /// Requested default scopes
  scope String?

  /// Client metadata URI for developer info
  clientUri String?

  /// When this client was registered
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  // -- Relations --
  authCodes         OAuthAuthCode[]
  grants            OAuthGrant[]
  mcpToolCallAudits McpToolCallAudit[] @relation("OAuthClientMcpToolCallAudits")
}

/// Short-lived authorization code issued during the OAuth consent flow.
/// Used once, then exchanged for access + refresh tokens.
model OAuthAuthCode {
  /// Unique identifier
  id String @id @default(cuid())

  /// The authorization code string
  code String @unique

  /// Client that requested the code
  clientId String

  /// User who authorized the request
  userId String

  /// Redirect URI used in the request (must match on token exchange)
  redirectUri String

  /// PKCE code challenge (S256 hash)
  codeChallenge String

  /// Granted scopes
  scopes McpScope[]

  /// When this code expires (10 minutes from creation)
  expiresAt DateTime

  /// Whether this code has been exchanged (prevents replay)
  used Boolean @default(false)

  /// When this record was created
  createdAt DateTime @default(now())

  // -- Relations --
  client OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User        @relation("UserOAuthAuthCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

/// Persistent record of a user granting an OAuth client access.
/// Enables "Connected Apps" UI, token revocation, and refresh token tracking.
model OAuthGrant {
  /// Unique identifier
  id String @id @default(cuid())

  /// Client that was granted access
  clientId String

  /// User who granted access
  userId String

  /// Scopes the user approved
  scopes McpScope[]

  /// SHA-256 hash of the refresh token (for lookup during refresh)
  refreshTokenHash String? @unique

  /// Whether the grant is still active (false = revoked)
  active Boolean @default(true)

  /// When the grant was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// When the grant was revoked (null if still active)
  revokedAt DateTime?

  // -- Relations --
  client            OAuthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user              User               @relation("UserOAuthGrants", fields: [userId], references: [id], onDelete: Cascade)
  mcpToolCallAudits McpToolCallAudit[] @relation("OAuthGrantMcpToolCallAudits")

  @@unique([clientId, userId])
  @@index([clientId])
  @@index([userId])
  @@index([refreshTokenHash])
}

/// Audit record for MCP tool calls that mutate Earth data or execute agent work.
/// Stores redacted summaries and hashes, not raw sensitive payloads.
model McpToolCallAudit {
  /// Unique identifier
  id String @id @default(cuid())

  /// Authenticated user whose OAuth token authorized the call
  userId String?

  /// Public OAuth client identifier, when the call came through remote MCP
  clientId String?

  /// OAuth grant row used by the client, when resolvable
  oauthGrantId String?

  /// Caller-supplied autonomous agent identifier
  agentId String?

  /// Caller-supplied run identifier, usually matching AgentRunCost.runId
  runId String?

  /// MCP tool name
  toolName String

  /// Final call status
  status McpToolCallStatus

  /// SHA-256 hash of the normalized input payload
  inputHash String?

  /// Redacted structural input summary
  inputSummaryJson Json?

  /// Redacted output resource summary
  outputSummaryJson Json?

  /// Short error summary for failed calls
  errorSummary String?

  /// When the call started
  createdAt DateTime @default(now())

  /// When the call completed
  completedAt DateTime?

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  user       User?        @relation("UserMcpToolCallAudits", fields: [userId], references: [id], onDelete: SetNull)
  client     OAuthClient? @relation("OAuthClientMcpToolCallAudits", fields: [clientId], references: [clientId], onDelete: SetNull)
  oauthGrant OAuthGrant?  @relation("OAuthGrantMcpToolCallAudits", fields: [oauthGrantId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([oauthGrantId])
  @@index([agentId])
  @@index([runId])
  @@index([toolName, createdAt])
  @@index([status, createdAt])
  @@index([deletedAt])
}

/// Crowd correction, abuse, duplicate, spam, and provenance report for public data.
model ContentReport {
  /// Unique identifier
  id String @id @default(cuid())

  /// Target model/table slug, e.g. "person", "person_memorial", "intervention_approval_timeline"
  targetType String

  /// Target row id
  targetId String

  /// User who filed the report
  reportedByUserId String?

  /// Reason slug, e.g. wrong, duplicate, spam, impersonation, abusive, unsourced
  reasonType String

  /// Optional reporter note
  message String?

  /// Proposed correction payload; reviewed before applying
  correctionJson Json?

  /// Optional source URL supporting the report/correction
  sourceUrl String?

  /// Review lifecycle
  status ContentReportStatus @default(OPEN)

  /// Admin/reviewer who resolved or dismissed it
  reviewedByUserId String?

  /// When the report was reviewed
  reviewedAt DateTime?

  /// Review/resolution note
  resolutionNote String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  reportedByUser User? @relation("UserReportedContentReports", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  reviewedByUser User? @relation("UserReviewedContentReports", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, status])
  @@index([reportedByUserId])
  @@index([reviewedByUserId])
  @@index([status, createdAt])
  @@index([deletedAt])
}

// ============================================================================
// REASONING — Autonomous persuasion optimizer
// ============================================================================
// Per the reasoning plan. 22 models + 7 enums. All namespaced with the
// `Reasoning` prefix. Runtime logic in packages/web/src/lib/reasoning/.

enum ReasoningVariantStatus {
  DRAFT
  REVIEW
  ACTIVE
  RETIRED
  FROZEN
}

enum ReasoningVariantSlot {
  HANDOFF
  CHAIN_NODE
  OBJECTION_NODE
  INEVITABILITY
  REPLICATION_CTA
  DEEP_CHAIN_NODE
  TOPOLOGY
}

enum ReasoningRiskTier {
  T1
  T2
  T3
}

enum ReasoningBanditLevel {
  GLOBAL
  LOCALE
  HOST
  ORG
  BUCKET
  SEGMENT
}

enum ReasoningGeneratorKind {
  HUMAN
  AI
  SYSTEM
}

enum ReasoningOutcomeKind {
  SURVEY_STARTED
  HANDOFF_CLICKED
  NODE_ADVANCED
  NODE_EXITED
  OBJECTION_SHOWN
  OBJECTION_RESOLVED
  PROBABILITY_CHANGED
  VOTE
  FIRST_SEND_INITIATED
  FIRST_SEND_CONFIRMED
  DOWNSTREAM_VOTE
  DOWNSTREAM_SEND
  WALK_AWAY
}

enum ReasoningVariantFamily {
  DRY_DATA
  EMOTIONAL_APPEAL
  CURIOSITY_MYSTERY
  SOCIAL_PROOF
  SELF_INTEREST_ROI
  MORAL_DUTY
  ABSURDIST_COMEDY
  DIRECT_IMPERATIVE
}

model ReasoningVariantSet {
  id              String                    @id @default(cuid())
  name            String                    @unique
  description     String?
  status          ReasoningVariantStatus    @default(DRAFT)
  parentSetId     String?
  parent          ReasoningVariantSet?      @relation("SetParent", fields: [parentSetId], references: [id])
  children        ReasoningVariantSet[]     @relation("SetParent")
  organizationId  String?
  allowedSlots    ReasoningVariantSlot[]
  isCanonical     Boolean                   @default(false)
  arms            ReasoningVariantArm[]
  assignmentRules ReasoningAssignmentRule[]
  orgFork         ReasoningOrgFork?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  createdByUserId String?

  @@index([status])
  @@index([organizationId])
}

model ReasoningVariantArm {
  id                  String                      @id @default(cuid())
  variantSetId        String
  set                 ReasoningVariantSet         @relation(fields: [variantSetId], references: [id], onDelete: Cascade)
  slot                ReasoningVariantSlot
  slotKey             String
  channel             String                      @default("default")
  riskTier            ReasoningRiskTier           @default(T1)
  content             Json
  status              ReasoningVariantStatus      @default(DRAFT)
  frozen              Boolean                     @default(false)
  armKey              String
  family              ReasoningVariantFamily
  noveltyScore        Float?
  localeKey           String
  parentArmId         String?
  parent              ReasoningVariantArm?        @relation("ArmParent", fields: [parentArmId], references: [id])
  children            ReasoningVariantArm[]       @relation("ArmParent")
  generatorKind       ReasoningGeneratorKind      @default(HUMAN)
  generationRequestId String?
  generationRequest   ReasoningGenerationRequest? @relation(fields: [generationRequestId], references: [id])
  fraudLineageFlagged Boolean                     @default(false)
  lastValidatedAt     DateTime?
  validatorVersion    String?
  validatorViolations Json?
  shadowEvaluations   ReasoningShadowEvaluation[]
  shadowGatePassed    Boolean?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@unique([variantSetId, slotKey, channel, localeKey, armKey])
  @@index([variantSetId, slotKey, channel, localeKey, status])
  @@index([slot, family, status])
  @@index([localeKey, slot, status])
  @@index([fraudLineageFlagged])
}

model ReasoningAssignmentRule {
  id                 String              @id @default(cuid())
  priority           Int                 @default(0)
  hostKey            String?
  organizationId     String?
  relationshipBucket String?
  audienceTag        String?
  referralSource     String?
  device             String?
  chainDepth         String?
  localeKey          String?
  surface            String?
  variantSetId       String
  variantSet         ReasoningVariantSet @relation(fields: [variantSetId], references: [id], onDelete: Cascade)
  isPin              Boolean             @default(false)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  createdByUserId    String?

  @@index([active, priority])
  @@index([variantSetId])
}

model ReasoningBanditPolicyState {
  id              String               @id @default(cuid())
  slot            ReasoningVariantSlot
  level           ReasoningBanditLevel
  segmentKey      String
  armPosteriors   Json
  exposureCount   Int                  @default(0)
  explorationRate Float                @default(1.0)
  updatedAt       DateTime             @updatedAt

  @@unique([slot, level, segmentKey])
  @@index([slot, level])
}

model ReasoningVariantExposure {
  id                     String                @id @default(cuid())
  sessionId              String
  userId                 String?
  policyDecisionId       String
  variantSetId           String
  variantArmId           String?
  slot                   ReasoningVariantSlot
  isControlHoldout       Boolean               @default(false)
  holdoutResolutionLevel ReasoningBanditLevel?
  orgContextVerified     Boolean               @default(false)
  surface                String                @default("hosted")
  localeKey              String
  hostKey                String
  organizationId         String?
  relationshipBucket     String?
  referralSource         String?
  device                 String?
  chainDepth             String
  returningVsFirst       String?
  referredByUserId       String?
  shareAttemptId         String?
  exposedAt              DateTime              @default(now())

  @@index([sessionId, exposedAt])
  @@index([variantArmId, exposedAt])
  @@index([referredByUserId])
  @@index([policyDecisionId])
  @@index([isControlHoldout, variantSetId])
  @@index([isControlHoldout, holdoutResolutionLevel])
  @@index([localeKey, variantSetId, exposedAt])
  @@index([surface, variantSetId, exposedAt])
}

model ReasoningOutcomeRecord {
  id                     String               @id @default(cuid())
  sessionId              String
  userId                 String?
  variantSetId           String
  variantArmId           String?
  slot                   ReasoningVariantSlot
  outcomeKind            ReasoningOutcomeKind
  value                  Float?
  rewardWeight           Float                @default(1.0)
  chainValueContribution Float?
  fraudPenalty           Float                @default(0.0)
  qualityPenalty         Float                @default(0.0)
  verifiedHumanWeight    Float                @default(1.0)
  localeKey              String
  surface                String               @default("hosted")
  channel                String?
  hostKey                String
  organizationId         String?
  audienceTag            String?
  relationshipBucket     String?
  referredByUserId       String?
  policyDecisionId       String?
  isControlHoldout       Boolean              @default(false)
  recordedAt             DateTime             @default(now())

  @@index([variantArmId, slot, outcomeKind, recordedAt])
  @@index([referredByUserId])
  @@index([isControlHoldout, variantSetId, recordedAt])
  @@index([localeKey, variantSetId, outcomeKind, recordedAt])
  @@index([organizationId, localeKey, recordedAt])
  @@index([surface, channel, localeKey, recordedAt])
}

model ReasoningHoldoutComparison {
  id                      String               @id @default(cuid())
  armId                   String
  slot                    ReasoningVariantSlot
  segmentKey              String
  windowStart             DateTime
  windowEnd               DateTime
  armChainValueMean       Float
  armChainValueVar        Float
  armExposures            Int
  canonicalChainValueMean Float
  canonicalChainValueVar  Float
  canonicalExposures      Int
  liftPointEstimate       Float
  liftCiLower             Float
  liftCiUpper             Float
  computedAt              DateTime             @default(now())

  @@index([armId, computedAt])
  @@index([slot, segmentKey, computedAt])
}

model ReasoningFraudPattern {
  id              String                  @id @default(cuid())
  patternKind     String
  pattern         Json
  action          String
  createdByUserId String?
  approved        Boolean                 @default(false)
  reason          String
  findings        ReasoningFraudFinding[]
  createdAt       DateTime                @default(now())

  @@index([approved])
}

model ReasoningFraudFinding {
  id          String                 @id @default(cuid())
  exposureId  String?
  sessionId   String?
  userId      String?
  patternId   String?
  pattern     ReasoningFraudPattern? @relation(fields: [patternId], references: [id])
  findingKind String
  severity    Float
  details     Json
  detectedAt  DateTime               @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([patternId])
}

model ReasoningOrgFork {
  id              String                 @id @default(cuid())
  organizationId  String                 @unique
  variantSetId    String                 @unique
  variantSet      ReasoningVariantSet    @relation(fields: [variantSetId], references: [id])
  allowedSlots    ReasoningVariantSlot[]
  createdAt       DateTime               @default(now())
  createdByUserId String
}

model ReasoningGenerationRequest {
  id                 String                 @id @default(cuid())
  requestedByUserId  String
  kind               ReasoningGeneratorKind
  slot               ReasoningVariantSlot
  slotKey            String
  targetVariantSetId String
  referenceArmIds    String[]
  toneProfile        String?
  aiModel            String?
  aiPrompt           String?
  requestedAt        DateTime               @default(now())
  candidateArmIds    String[]
  arms               ReasoningVariantArm[]
}

model ReasoningPromotionDecision {
  id                      String                 @id @default(cuid())
  armId                   String
  fromStatus              ReasoningVariantStatus
  toStatus                ReasoningVariantStatus
  tier                    ReasoningRiskTier
  actorKind               ReasoningGeneratorKind
  actorUserId             String?
  chainValueEvidence      Json
  fraudEvidence           Json
  rGuardSnapshot          Json
  chainValueGuardSnapshot Json
  topologyGateState       String
  rationale               String
  decidedAt               DateTime               @default(now())

  @@index([armId, decidedAt])
}

model ReasoningBlacklistRule {
  id              String                @id @default(cuid())
  scope           ReasoningVariantSlot?
  patternKind     String
  pattern         String
  reason          String
  createdByUserId String
  createdAt       DateTime              @default(now())
  active          Boolean               @default(true)

  @@index([active, scope])
}

model ReasoningTopologyVariant {
  id                     String                 @id @default(cuid())
  name                   String                 @unique
  description            String
  grammarPatch           Json
  riskTier               ReasoningRiskTier
  status                 ReasoningVariantStatus @default(DRAFT)
  activationGateRequired Boolean                @default(true)
  createdAt              DateTime               @default(now())
}

model ReasoningRGuardSnapshot {
  id              String   @id @default(cuid())
  rSevenDay       Float
  components      Json
  triggeredRevert Boolean  @default(false)
  snapshotAt      DateTime @default(now())

  @@index([snapshotAt])
}

model ReasoningChainValueGuardSnapshot {
  id                             String   @id @default(cuid())
  globalChainValueMean           Float
  canonicalHoldoutChainValueMean Float
  deltaPct                       Float
  triggeredRevert                Boolean  @default(false)
  snapshotAt                     DateTime @default(now())

  @@index([snapshotAt])
}

model ReasoningSystemState {
  id                      String    @id @default("singleton")
  topologyGateOpen        Boolean   @default(false)
  promoterFrozen          Boolean   @default(false)
  allocatorForceCanonical Boolean   @default(false)
  lastFreezeReason        String?
  lastFreezeAt            DateTime?
  lastUnfreezeAt          DateTime?
  lastUnfreezeByUserId    String?
  updatedAt               DateTime  @updatedAt
}

model ReasoningShadowEvaluation {
  id                      String               @id @default(cuid())
  armId                   String
  arm                     ReasoningVariantArm  @relation(fields: [armId], references: [id], onDelete: Cascade)
  slot                    ReasoningVariantSlot
  segmentKey              String
  estimator               String
  shadowChainValueMean    Float
  shadowChainValueCiLower Float
  shadowChainValueCiUpper Float
  canonicalBaselineMean   Float
  propensityOverlap       Float
  evaluatedOnExposures    Int
  gateDecision            String
  rationale               String
  computedAt              DateTime             @default(now())

  @@index([armId, computedAt])
  @@index([gateDecision])
}

model ReasoningDiversitySnapshot {
  id                 String               @id @default(cuid())
  slot               ReasoningVariantSlot
  segmentKey         String
  familyDistribution Json
  shannonEntropy     Float
  activeFamilyCount  Int
  alertLevel         String
  computedAt         DateTime             @default(now())

  @@index([slot, segmentKey, computedAt])
  @@index([alertLevel, computedAt])
}

model ReasoningLocaleConfig {
  id               String   @id @default(cuid())
  localeKey        String   @unique
  displayName      String
  enabled          Boolean  @default(false)
  fallbackChain    String[] @default([])
  bannedPhrases    Json     @default("[]")
  fraudBaselines   Json     @default("{}")
  generatorQuota   Json     @default("{}")
  reviewerUserIds  String[] @default([])
  audienceEstimate Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByUserId  String?
}

model ReasoningDistributionPolicyState {
  id                        String   @id @default(cuid())
  organizationId            String?
  localeKey                 String?
  channel                   String?
  surface                   String?
  generationBudgetWeight    Float    @default(1.0)
  explorationRateMultiplier Float    @default(1.0)
  onboardingPriority        Float?
  currentYield              Float?
  currentSupply             Int?
  marginalYieldEstimate     Float?
  effortSpent               Json?
  updatedAt                 DateTime @updatedAt

  @@unique([organizationId, localeKey, channel, surface])
  @@index([onboardingPriority])
}

model ReasoningDistributionSliceSnapshot {
  id              String   @id @default(cuid())
  organizationId  String?
  localeKey       String?
  channel         String?
  surface         String?
  yield           Float
  supply          Int
  ceilingEstimate Float?
  marginalYield   Float?
  recordedAt      DateTime @default(now())

  @@index([organizationId, localeKey, channel, surface, recordedAt])
}

model ReasoningOrganizationDomain {
  id                   String    @id @default(cuid())
  organizationId       String
  host                 String    @unique
  surfaceType          String
  status               String
  trustedParentDomains String[]  @default([])
  cspAllowlist         String[]  @default([])
  tlsVerified          Boolean   @default(false)
  cnameVerified        Boolean   @default(false)
  verifiedAt           DateTime?
  createdByUserId      String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([organizationId])
  @@index([status])
}

model ReasoningDistributionTarget {
  id              String   @id @default(cuid())
  organizationId  String?
  localeKey       String?
  channel         String?
  surface         String?
  enabled         Boolean  @default(false)
  ceilingEstimate Float
  liveStatus      String
  notes           String?
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, localeKey, channel, surface])
  @@index([enabled, liveStatus])
}

model ReasoningBundleVariant {
  id                     String                 @id @default(cuid())
  name                   String                 @unique
  description            String
  armBindings            Json
  status                 ReasoningVariantStatus @default(DRAFT)
  riskTier               ReasoningRiskTier      @default(T2)
  exposures              Int                    @default(0)
  chainValueSum          Float                  @default(0)
  chainValueSumSq        Float                  @default(0)
  activationGateRequired Boolean                @default(true)
  createdByUserId        String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([status, riskTier])
}
