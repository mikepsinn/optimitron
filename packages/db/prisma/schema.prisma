  unit                   Unit?                  @relation("InterventionExperienceOutcomeUnit", fields: [unitId], references: [id], onDelete: SetNull)
  beforeMeasurement      Measurement?           @relation("InterventionOutcomeBeforeMeasurement", fields: [beforeMeasurementId], references: [id], onDelete: SetNull)
