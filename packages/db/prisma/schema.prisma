  doseUnit                   Unit?                              @relation("InterventionExperienceDoseUnit", fields: [doseUnitId], references: [id], onDelete: SetNull)
  sourceArtifact             SourceArtifact?                    @relation("SourceArtifactInterventionExperiences", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
