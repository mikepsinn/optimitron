/// Reference row for regulatory approval lag between first evidence and approval.
model InterventionApprovalTimeline {
  /// Unique identifier for this timeline row
  id String @id @default(cuid())

  /// Source/display intervention name from the approval dataset. This is kept
  /// even when interventionGlobalVariableId is set because imported regulatory
  /// records need their original label preserved.
  interventionName String

  /// Optional brand name
  brandName String?

  /// Optional canonical intervention variable link for joins/ranking. Writers
  /// should preserve interventionName and set this when canonicalization is
  /// available.
  interventionGlobalVariableId String?

  /// Source/display condition name from the approval dataset. This is kept even
  /// when conditionGlobalVariableId is set because imported records need their
  /// original indication text preserved.
  conditionName String

  /// Optional canonical condition/outcome variable link for matching and
  /// querying. Writers should preserve conditionName and set this when
  /// canonicalization is available.
  conditionGlobalVariableId String?

  /// Regulator/jurisdiction responsible for approval, e.g. United States/FDA
  jurisdictionId String?

  /// Free-text regulator name before canonical mapping
  regulatorName String?

  /// Date of first efficacy evidence
  firstEvidenceDate DateTime?

  /// Description/source context for first evidence
  firstEvidenceDescription String?

  /// Date of regulatory approval
  approvalDate DateTime?

  /// Description/source context for approval
  approvalDescription String?

  /// Approval minus first evidence, cached in days when both dates are known
  efficacyLagDays Int?

  /// Estimated lives saved per year after approval
  estimatedLivesSavedPerYear Float?

  /// Estimated deaths during approval lag
  estimatedDeathsDuringLag Float?

  /// Source URL for provenance
  sourceUrl String?

  /// Optional shared source artifact/provenance row
  sourceArtifactId String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  interventionGlobalVariable GlobalVariable?             @relation("InterventionApprovalInterventionVariable", fields: [interventionGlobalVariableId], references: [id], onDelete: SetNull)
  conditionGlobalVariable    GlobalVariable?             @relation("InterventionApprovalConditionVariable", fields: [conditionGlobalVariableId], references: [id], onDelete: SetNull)
  jurisdiction               Jurisdiction?               @relation("JurisdictionInterventionApprovalTimelines", fields: [jurisdictionId], references: [id], onDelete: SetNull)
  sourceArtifact             SourceArtifact?             @relation("SourceArtifactInterventionApprovalTimelines", fields: [sourceArtifactId], references: [id], onDelete: SetNull)
  efficacyLagEvidence        PersonEfficacyLagEvidence[] @relation("InterventionApprovalEfficacyLagEvidence")
}

/// Computed evidence that a memorialized person died during an approval lag.
model PersonEfficacyLagEvidence {
  /// Unique identifier for this efficacy-lag match
  id String @id @default(cuid())

  /// Memorial/death case being matched
  memorialId String

  /// Condition/cause row used for the match, when available
  personConditionId String?

  /// Intervention timeline used for the match
  interventionApprovalTimelineId String

  /// Review/computation status
  status EfficacyLagEvidenceStatus @default(CANDIDATE)

  /// Days between death and eventual approval when death occurred before approval
  diedBeforeApprovalDays Int?

  /// Human-readable explanation for notices and evidence packages
  explanation String?

  /// Confidence score from 0 to 1
  confidenceScore Float?

  /// When this match was computed
  computedAt DateTime @default(now())

  /// Reviewer for confirmed/rejected matches
  reviewedByUserId String?

  /// When this match was reviewed
  reviewedAt DateTime?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  memorial                     PersonMemorial               @relation("PersonMemorialEfficacyLagEvidence", fields: [memorialId], references: [id], onDelete: Cascade)
  personCondition              PersonCondition?             @relation("PersonConditionEfficacyLagEvidence", fields: [personConditionId], references: [id], onDelete: SetNull)
  interventionApprovalTimeline InterventionApprovalTimeline @relation("InterventionApprovalEfficacyLagEvidence", fields: [interventionApprovalTimelineId], references: [id], onDelete: Cascade)
  reviewedByUser               User?                        @relation("UserReviewedPersonEfficacyLagEvidence", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([memorialId, interventionApprovalTimelineId], map: "PersonEfficacyLagEvidence_memorial_timeline_key")
}

/// Application user account used for Optimitron and Wishocracy sign-in
model User {
