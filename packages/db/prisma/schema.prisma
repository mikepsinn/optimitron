  TWITTER
  GITHUB
  ETHEREUM
  BASE
  DISCORD
  TELEGRAM
}

/// Achievement badge type
enum BadgeType {
  FIRST_COMPARISON
  HUNDRED_COMPARISONS
  FIRST_RECRUIT
  TEN_RECRUITS
  VERIFIED_HUMAN
  EARLY_ADOPTER
  DEPOSITOR
}

/// Reason a wish was granted — maps to a specific user action
enum WishReason {
  WORLD_ID_VERIFICATION
  KYC_COMPLETION
  CENSUS_SNAPSHOT
  DAILY_CHECKIN
  WISHOCRATIC_ALLOCATION
  REFERENDUM_VOTE
  ALIGNMENT_CHECK
  REFERRAL
  PRIZE_DEPOSIT
  SHARE_REPORT
  TASK_COMPLETED
}

/// Canonical task difficulty used for matching and onboarding
enum TaskDifficulty {
  TRIVIAL
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

/// High-level task taxonomy for filtering and recommendations
enum TaskCategory {
  ADVOCACY
  RESEARCH
  COMMUNICATION
  ENGINEERING
  ORGANIZING
  OUTREACH
  GOVERNANCE
  SCIENCE
  LEGAL
  CREATIVE
  OTHER
}

/// Controls whether a task is assigned directly or how many simultaneous active claims it can accept
enum TaskClaimPolicy {
  /// Public accountability item addressed to one person; never claimable by other users
  ASSIGNED_ONLY
  /// Claimable, but only one active claimant can hold it at a time
  OPEN_SINGLE
  /// Claimable by multiple users at once, optionally capped by maxClaims
  OPEN_MANY
}

/// Lifecycle state for a task itself
enum TaskStatus {
  DRAFT
  ACTIVE
  VERIFIED
  STALE
}

/// How a due date affects availability and next-action selection.
enum TaskDeadlinePolicy {
  /// No scheduling constraint.
  NONE
  /// Informational target date; does not override priority.
  SOFT
  /// Opportunity expires after dueAt.
  EXPIRES
  /// Required work remains visible after dueAt as missed/remediation work.
  REQUIRED
}

/// Lifecycle state for an individual user's claim on a task.
/// The currently exposed flow is CLAIMED -> COMPLETED -> VERIFIED, with
/// ABANDONED/REJECTED retained for reclaim and reviewer workflows.
enum TaskClaimStatus {
  CLAIMED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  REJECTED
  ABANDONED
}

/// Lifecycle state for a milestone attached to a task
enum TaskMilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  VERIFIED
}

/// Non-hierarchical relationship between tasks for causal and dependency modeling
enum TaskEdgeType {
  DEPENDS_ON
  BLOCKS
  INCREASES_PROBABILITY_OF
  ACCELERATES
}

/// Upstream source family for tasks, impacts, and analytical artifacts
enum SourceSystem {
  MANUAL
  OPG
  OBG
  PARAMETER_CATALOG
  EXTERNAL
  CURATED
  COMBINED
}

/// Type of upstream artifact used to derive tasks or impact estimates
enum SourceArtifactType {
  MANUAL_SECTION
  MANUAL_SNAPSHOT
  OPG_POLICY_RECOMMENDATION
  OPG_POLICY_REPORT
  OBG_BUDGET_CATEGORY
  OBG_BUDGET_REPORT
  PARAMETER_SET
  CALCULATION_RUN
  EXTERNAL_SOURCE
}

/// Whether an impact estimate is ex-ante, ex-post, or mixed
enum TaskImpactEstimateKind {
  FORECAST
  OBSERVED
  HYBRID
}

/// Publication lifecycle for an impact estimate set
enum TaskImpactPublicationStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  SUPERSEDED
}

/// Named time horizon for a task impact frame
enum TaskImpactFrameKey {
  IMMEDIATE
  ONE_YEAR
  FIVE_YEAR
  TWENTY_YEAR
  LIFETIME
  CUSTOM
}

/// Who a task communication is addressed to. Distinct from TaskComment
/// (readable thread) and Notification (in-app alert). Drives template
/// selection, endpoint choice, and cadence.
enum TaskCommunicationAudience {
  /// Person being asked to complete the task (e.g. named-invite recipient).
  RECIPIENT
  /// Person doing the asking (sender / project manager).
  SENDER
  /// Public broadcast / share-template audience.
  OBSERVER
  /// External assignee asked to complete the task.
  ASSIGNEE
}

/// Lifecycle purpose of a task communication template within an audience's sequence.
enum TaskCommunicationPurpose {
  /// First-touch named-invite or assignment email.
  INVITATION
  /// First-touch task assignment to an assignee or organization.
  ASSIGNMENT
  /// Follow-up reminder to take action.
  REMINDER
  /// Follow-up after an assignment, reply, or missed deadline.
  FOLLOW_UP
  /// Request for proof, evidence, or status detail.
  EVIDENCE_REQUEST
  /// Status note communicated to the task thread or assignee.
  STATUS_UPDATE
  /// Inbound reply captured as part of the task thread.
  REPLY
  /// Periodic progress summary (e.g. monthly scorecard).
  SCORECARD
  /// Bring back a user who acted but never followed through (e.g. C1).
  RE_ENGAGEMENT
  /// Confirmation after the audience completed their action.
  VOTE_CONFIRMED
  /// Notification to a sender that their recipient acted.
  RECIPIENT_VOTED
  /// Share-template variants (audience = OBSERVER).
  SHARE
}

/// Format / style branch within a template - e.g. TASK_NOTIFICATION vs SINCERE
/// for the named-invite recipient sequence. DEFAULT is for templates that do
/// not branch on format.
enum TaskCommunicationFormat {
  DEFAULT
  TASK_NOTIFICATION
  SINCERE
}

/// Direction of a task communication.
enum TaskCommunicationDirection {
  OUTBOUND
  INBOUND
}

/// Channel used by a task communication envelope.
enum TaskCommunicationChannel {
  EMAIL
  IN_APP
  SMS
  PUSH
  EXTERNAL_URL
  MAILTO
  MANUAL
}

/// Channel-agnostic lifecycle status of a single TaskCommunication row.
enum TaskCommunicationStatus {
  /// Drafted but not sent/opened/imported yet.
  DRAFT
  /// Outbound communication was sent, opened, or initiated.
  SENT
  /// Inbound communication or manual response was received.
  RECEIVED
  /// Delivery/action failed.
  FAILED
  /// Cancelled, suppressed, or unsubscribed before send.
  CANCELLED
}

/// Stored assignee contact method for a task.
enum TaskCommunicationEndpointKind {
  EMAIL
  MAILTO
  EXTERNAL_URL
  FORM_URL
  PUBLIC_PROFILE
  IN_APP
  MANUAL
}

/// Verification state for a task communication endpoint.
enum TaskCommunicationEndpointVerificationStatus {
  UNVERIFIED
  VERIFIED
  STALE
  FAILED
}

/// Readable role of a TaskComment row in the task thread.
enum TaskCommentKind {
  COMMENT
  OUTBOUND_MESSAGE
  INBOUND_MESSAGE
  STATUS_UPDATE
  SYSTEM_NOTE
}

/// Who can see a TaskComment.
enum TaskCommentVisibility {
  PUBLIC
  INTERNAL
}

/// How a TaskComment entered the system.
enum TaskCommentSource {
  WEB
  AGENT
  EMAIL_REPLY
  MANUAL_IMPORT
  SYSTEM
}

/// MCP OAuth permission scopes. The Prisma identifier is what app code sees;
/// `@map` gives the OAuth wire format ("tasks:personal") that's stored in the DB
/// and surfaced in URLs / JWTs / OAuth metadata.
enum McpScope {
  TASKS_ADMIN     @map("tasks:admin")
  TASKS_PERSONAL  @map("tasks:personal")
  AGENT_RUN       @map("agent:run")
  EARTHDATA_WRITE @map("earthdata:write")
  EARTHDATA_ADMIN @map("earthdata:admin")
  /// Server-side GitHub API access via the configured PAT. Covers the
  /// repo-allowlist-gated read tools and the `githubApi` passthrough.
  /// Distinct from TASKS_ADMIN because GitHub access is orthogonal to
  /// task-platform admin — an integration could be granted GITHUB
  /// without touching task admin operations.
  GITHUB          @map("github")
}

/// Status of a recorded MCP tool call.
enum McpToolCallStatus {
  SUCCEEDED
  FAILED
}

/// Public content correction/report lifecycle.
enum ContentReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Type of survey question
enum QuestionType {
  MULTIPLE_CHOICE
  FREE_TEXT
  RATING
  BOOLEAN
  NUMERIC
}

/// Delivery status for email log
enum EmailLogStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

// ============================================================================
// AUTH / ACCOUNT LAYER
// ============================================================================

/// Canonical human identity record used for signed-up users and public figures who have tasks
model Person {
  /// Unique identifier for this person
  id String @id @default(cuid())

  /// Public, human-readable handle used in URLs (e.g. /people/wishonia).
  /// Lower-case, hyphen-separated, globally unique. Falls back to `id` when null.
  handle String? @unique

  /// Public display name
  displayName String

  /// Optional email for signup linking
  email String? @unique

  /// Optional portrait or avatar
  image String?

  /// Optional short biography
  bio String?

  /// Known birth date when available
  birthDate DateTime?

  /// Known death date when available
  deathDate DateTime?

  /// Optional public links (twitter, website, wikipedia, etc.) as a JSON object
  /// keyed by platform name. Shape: { twitter: "url", website: "url", ... }
  links Json?

  /// Optional current affiliation or institution
  currentAffiliation String?

  /// Optional country code for matching and accountability views
  countryCode String?

  /// One-line headline shown above the bio (e.g. "Data scientist at X")
  headline String?

  /// Cover/banner image URL for the public profile
  coverImage String?

  /// Personal website URL (also tracked alongside other social handles in `links`)
  website String?

  /// Whether the public profile at /people/{handle} is visible to anyone
  isPublic Boolean @default(false)

  /// Whether this person primarily exists as a public figure / officeholder record
  isPublicFigure Boolean @default(false)

  /// Known life state for public and user-created human records
  lifeStatus PersonLifeStatus @default(UNKNOWN)

  /// User who created this Person record, when it was created inside Optimitron
  createdByUserId String?

  /// Source URL used when this person was imported from public/manual data
  sourceUrl String?

  /// Stable source reference used for idempotent imports
  sourceRef String? @unique

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  createdByUser               User?                @relation("UserCreatedPeople", fields: [createdByUserId], references: [id], onDelete: SetNull)
  user                        User?                @relation("UserPerson")
  subject                     Subject?             @relation("PersonSubject")
  referendumVotes             ReferendumVote[]     @relation("PersonReferendumVotes")
  conditions                  PersonCondition[]    @relation("PersonConditions")
  memorial                    PersonMemorial?      @relation("PersonMemorialPerson")
  relationshipsAsSubject      PersonRelationship[] @relation("PersonRelationshipSubject")
  relationshipsAsObject       PersonRelationship[] @relation("PersonRelationshipObject")
  assignedTasks               Task[]               @relation("TaskAssigneePerson")
  receivedReferralInvitations ReferralInvitation[] @relation("ReferralInvitationRecipientPerson")
  authoredTaskComments        TaskComment[]        @relation("TaskCommentAuthorPerson")
  receivedTaskCommunications  TaskCommunication[]  @relation("TaskCommunicationRecipientPerson")
  sentTaskCommunications      TaskCommunication[]  @relation("TaskCommunicationSenderPerson")

  @@index([displayName])
  @@index([deathDate])
  @@index([countryCode])
  @@index([createdByUserId])
  @@index([lifeStatus])
  @@index([isPublic])
  @@index([isPublicFigure])
  @@index([deletedAt])
}

/// Directional relationship between two human records. The relationshipType is
/// a free-form slug so new human categories do not require enum migrations.
model PersonRelationship {
  /// Unique identifier for this relationship
  id String @id @default(cuid())

  /// Person the relationship is from
  subjectPersonId String

  /// Person the relationship points to
  objectPersonId String

  /// Directional slug, e.g. "grandchild-of", "friend-of", "caregiver-of"
  relationshipType String

  /// User who entered this relationship, when known
  createdByUserId String?

  /// Whether this relationship is visible on public pages
  isPublic Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  subjectPerson Person @relation("PersonRelationshipSubject", fields: [subjectPersonId], references: [id], onDelete: Cascade)
  objectPerson  Person @relation("PersonRelationshipObject", fields: [objectPersonId], references: [id], onDelete: Cascade)
  createdByUser User?  @relation("UserCreatedPersonRelationships", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([subjectPersonId])
  @@index([objectPersonId])
  @@index([createdByUserId])
}

/// Public or private condition/cause attached to a human record.
model PersonCondition {
  /// Unique identifier for this person-condition row
  id String @id @default(cuid())

  /// Person this condition belongs to
  personId String

  /// Human-readable condition or cause name
  conditionName String

  /// Coding system for canonical condition identifiers, e.g. "ICD-10"
  conditionCodeSystem String?

  /// Canonical condition identifier within conditionCodeSystem
  conditionCode String?

  /// Optional canonical variable for later DFDA/health modeling
  globalVariableId String?

  /// Current or historical relationship to the person
  status PersonConditionStatus @default(ACTIVE)

  /// User who reported this condition, when known
  reportedByUserId String?

  /// Optional public source URL
  sourceUrl String?

  /// Whether this condition is visible on public pages
  isPublic Boolean @default(true)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  person              Person                      @relation("PersonConditions", fields: [personId], references: [id], onDelete: Cascade)
  globalVariable      GlobalVariable?             @relation("GlobalVariablePersonConditions", fields: [globalVariableId], references: [id], onDelete: SetNull)
  reportedByUser      User?                       @relation("UserReportedPersonConditions", fields: [reportedByUserId], references: [id], onDelete: SetNull)
  primaryForMemorials PersonMemorial[]            @relation("PersonMemorialPrimaryCondition")
  efficacyLagEvidence PersonEfficacyLagEvidence[] @relation("PersonConditionEfficacyLagEvidence")

  @@index([personId])
  @@index([globalVariableId])
  @@index([conditionName])
  @@index([conditionCodeSystem, conditionCode])
  @@index([status])
}

/// Named conflict reference used by memorials and prosecution dashboards.
model Conflict {
  /// Unique identifier for this conflict
  id String @id @default(cuid())

  /// Stable slug for URLs/imports
  slug String @unique

  /// Human-readable conflict name
  name String

  /// Optional description
  description String?

  /// When the conflict began, if known
  startDate DateTime?

  /// When the conflict ended, if known
  endDate DateTime?

  /// Primary jurisdiction associated with this conflict, when useful
  primaryJurisdictionId String?

  /// Source URL for provenance
  sourceUrl String?

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  primaryJurisdiction Jurisdiction?    @relation("ConflictPrimaryJurisdiction", fields: [primaryJurisdictionId], references: [id], onDelete: SetNull)
  memorials           PersonMemorial[] @relation("PersonMemorialConflict")

  @@index([name])
  @@index([startDate])
  @@index([endDate])
  @@index([primaryJurisdictionId])
  @@index([deletedAt])
}

/// Death/memorial/legal-evidence record attached to a Person.
model PersonMemorial {
  /// Unique identifier for this memorial/death case
  id String @id @default(cuid())

  /// The human being memorialized
  personId String @unique

  /// Broad cause category for filtering and dashboards
  causeCategory PersonDeathCauseCategory @default(UNKNOWN)

  /// Primary disease/condition cause when applicable
  primaryPersonConditionId String?

  /// ISO country code where death occurred, when known
  deathCountryCode String?

  /// Human-readable death location
  deathLocation String?

  /// Optional named conflict reference
  conflictId String?

  /// Conflict/state-violence civilian status
  civilianStatus PersonCivilianStatus @default(UNKNOWN)

  /// Whether the decedent was a child
  wasChild Boolean?

  /// Structured summary of what happened
  circumstances String?

  /// Whether memorial details may be displayed publicly
  isPublic Boolean @default(false)

  /// When this record was created
  createdAt DateTime @default(now())

  /// When this record was last updated
  updatedAt DateTime @updatedAt

  /// Soft-delete timestamp
  deletedAt DateTime?

  // -- Relations --
  person                 Person                           @relation("PersonMemorialPerson", fields: [personId], references: [id], onDelete: Cascade)
  primaryPersonCondition PersonCondition?                 @relation("PersonMemorialPrimaryCondition", fields: [primaryPersonConditionId], references: [id], onDelete: SetNull)
