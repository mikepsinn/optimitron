  UNKNOWN
  CIVILIAN
  COMBATANT
}

/// Evidence artifact category for memorial/court records.
enum PersonMemorialEvidenceKind {
  PHOTO
  DOCUMENT
  NEWS_ARTICLE
  HOSPITAL_RECORD
  DEATH_RECORD
  WITNESS_STATEMENT
  OTHER
}

/// Review state for computed efficacy-lag evidence matches.
