{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "node ../../.github/scripts/vercel-ignore-build.mjs curedao",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/preview-curedao-*": true,
      "feature/preview-all-*": true,
      "**": false
    }
  },
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @optimitron/db run prisma:generate && pnpm build:app-dependencies && pnpm --filter @apps/curedao run build"
}
