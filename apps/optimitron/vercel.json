{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node ../../.github/scripts/vercel-app-env.mjs optimitron && pnpm run build:vercel",
  "ignoreCommand": "node ../../.github/scripts/vercel-ignore-build.mjs optimitron",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "gh-pages": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/run-due-triggers",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/alignment-politicians",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/push-notifications",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/point-mint",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/refresh-user-downstream-cache",
      "schedule": "0 4 * * 0"
    },
    {
      "path": "/api/cron/aggregate-relationships",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/referral-hypercert-publish",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/daily-activity-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/monthly-chain-digest",
      "schedule": "0 14 1 * *"
    },
    {
      "path": "/api/cron/task-payouts",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/task-funding",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/task-comment-attachments",
      "schedule": "0 4 * * *"
    }
  ]
}
