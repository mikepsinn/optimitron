# Database Configuration
# PostgreSQL connection URL from Neon Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
# Unpooled connection for Prisma migrations (Neon official naming)
DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"

# NextAuth Configuration
# Secret key for encrypting JWT tokens - generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"
# Base URL for NextAuth callbacks
# For development: http://localhost:3013
# For production: https://dih.earth (or your primary domain)
# NOTE: Each variant domain needs to be added to OAuth provider settings
NEXTAUTH_URL="http://localhost:3013"

# Email Provider - Resend
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM_ADDRESS="no-reply@updates.dfda.earth"
EMAIL_FROM_NAME="Decentralized Institutes of Health"

# OAuth Providers - Google
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: Additional OAuth Providers (uncomment to use)
# OAuth Providers - GitHub
# Get credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID="your-github-client-id"
# GITHUB_CLIENT_SECRET="your-github-client-secret"

# OAuth Providers - Twitter/X
# Get credentials from: https://developer.twitter.com/en/portal/dashboard
# TWITTER_CLIENT_ID="your-twitter-client-id"
# TWITTER_CLIENT_SECRET="your-twitter-client-secret"

# OAuth Providers - Discord
# Get credentials from: https://discord.com/developers/applications
# DISCORD_CLIENT_ID="your-discord-client-id"
# DISCORD_CLIENT_SECRET="your-discord-client-secret"

# Stripe Payment Configuration
# Get API keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key_here"

# Stripe Webhook Secret
# Get from: https://dashboard.stripe.com/webhooks
# Used to verify webhook signatures from Stripe
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"

# Cron Job Secret
# Generate with: openssl rand -base64 32
# Used to secure Vercel cron endpoints (e.g., weekly emails)
CRON_SECRET="your-cron-secret-here"

# Google Analytics 4
# Get measurement ID from: https://analytics.google.com/ → Admin → Data Streams → Web
# Format: G-XXXXXXXXXX (measurement ID starting with "G-")
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Sentry Error Tracking & Performance Monitoring
# Get DSN from: https://sentry.io/settings/[your-org]/projects/[your-project]/keys/
# The DSN tells Sentry where to send error reports (Note: DSNs are public-facing and safe to commit)
NEXT_PUBLIC_SENTRY_DSN="https://05fd7ae2a8f9f500118226c8352f98a2@o926849.ingest.us.sentry.io/4510311005749248"

# Optional: Sentry Source Maps Upload (for production)
# Get these from: https://sentry.io/settings/[your-org]/auth-tokens/
# SENTRY_AUTH_TOKEN="your-sentry-auth-token"
# SENTRY_ORG="your-sentry-organization-slug"
# SENTRY_PROJECT="your-sentry-project-slug"

# Environment
NODE_ENV="development"
