# Database and authentication
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"
NEXTAUTH_SECRET="generate-a-random-32-byte-secret"
# Must equal the optimitron web project's MCP token secret so dfda.earth/api/mcp
# can verify Bearer tokens issued by optimitron.com. Locally the shared root .env
# NEXTAUTH_SECRET fallback covers it.
MCP_TOKEN_SECRET=""
NEXTAUTH_URL="http://localhost:3011"

# Optional sign-in and email providers
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM_ADDRESS="no-reply@dfda.earth"
EMAIL_FROM_NAME="dFDA"
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# AI-assisted evidence tools
GOOGLE_GENERATIVE_AI_API_KEY="your-google-ai-api-key"

# Optional analytics and error reporting
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
