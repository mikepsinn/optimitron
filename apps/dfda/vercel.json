{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "ignoreCommand": "node ../../.github/scripts/vercel-ignore-build.mjs dfda",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feature/preview-dfda-*": true,
      "feature/preview-all-*": true,
      "*": false
    }
  },
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "buildCommand": "cd ../.. && pnpm --filter @optimitron/db run prisma:generate && pnpm build:app-dependencies && pnpm --filter @apps/dfda run build"
}
