{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@optimitron/site-kit": [
        "../../packages/site-kit/src/components/layout.tsx"
      ],
      "@optimitron/site-kit/*": ["../../packages/site-kit/src/*"],
      "@/components/landing/*": [
        "./components/landing/*",
        "../../packages/site-kit/src/components/landing/*"
      ],
      "@/components/dashboard/*": [
        "../../packages/site-kit/src/components/dashboard/*"
      ],
      "@/components/auth/*": [
        "./components/auth/*",
        "../../packages/site-kit/src/components/auth/*"
      ],
      "@/components/shared/*": [
        "./components/shared/*",
        "../../packages/site-kit/src/components/shared/*"
      ],
      "@/components/charts/*": [
        "./components/charts/*",
        "../../packages/site-kit/src/components/charts/*"
      ],
      "@/components/sharing/*": [
        "./components/sharing/*",
        "../../packages/site-kit/src/components/sharing/*"
      ],
      "@/components/layout": [
        "../../packages/site-kit/src/components/layout.tsx"
      ],
      "@/components/providers": [
        "../../packages/site-kit/src/components/providers.tsx"
      ],
      "@/components/theme-provider": [
        "../../packages/site-kit/src/components/theme-provider.tsx"
      ],
      "@/components/sentry-404-reporter": [
        "../../packages/site-kit/src/components/sentry-404-reporter.tsx"
      ],
      "@/types/dashboard": ["../../packages/site-kit/src/types/dashboard.ts"],
      "@/lib/*": ["./lib/*", "../../packages/site-kit/src/lib/*"],
      "@/*": ["./*"],
      "@optimitron/neobrutalist-ui": [
        "../../packages/neobrutalist-ui/src/index.ts"
      ],
      "@optimitron/neobrutalist-ui/*": ["../../packages/neobrutalist-ui/src/*"],
      "@optimitron/data": ["../../packages/data/src/index.ts"],
      "@optimitron/data/*": ["../../packages/data/src/*"],
      "@/components/ui/*": ["../../packages/neobrutalist-ui/src/ui/*"],
      "@/lib/utils": ["../../packages/neobrutalist-ui/src/cn.ts"],
      "@/lib/parameters-calculations-citations": [
        "../../packages/data/src/parameters/parameters-calculations-citations.ts"
      ],
      "@/lib/format-parameter": [
        "../../packages/data/src/parameters/compact-format.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "../next-auth.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "vitest.config.ts",
    "tests",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
