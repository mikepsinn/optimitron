# Database: form submissions (sign-ups, endorsements, partner and contact messages)
DATABASE_URL="postgresql://user:password@host-pooler/database?sslmode=require"

# Required in production: a Resend sending key for updates.acceleratedmedicine.org
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM_ADDRESS="no-reply@updates.acceleratedmedicine.org"

# Required in production: public-form rate limiting and signed confirmation links
RIGHT_TO_TRY_RATE_LIMIT_SECRET="generate-a-random-rate-limit-secret"

# Optional, and best left unset: a Resend audience that confirmed supporters who want updates join. It needs a
# full-access API key, and the database records every opt-in either way.
# RESEND_AUDIENCE_ID="your-resend-audience-id"

# Optional analytics and error reporting
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
